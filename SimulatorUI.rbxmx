	text("VALUE!", merge(rect(652, 76, 160, 44), { TextColor3 = rgb(255, 210, 40), Parent = b2 }), 4)
	local buyPack = fancy("TextButton", merge(rect(657, 120, 200, 62), { Name = "BuyStarterPack", Parent = b2 }),
