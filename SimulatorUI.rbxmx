	text(ex.BuyMany.Label, merge(rect(20, 46, 155, 22), { Parent = buyMany }), 2)
	if ex.BuyMany.OldPrice then
		local oldPrice = robuxPrice(buyMany, "<s>" .. ex.BuyMany.OldPrice .. "</s>", rect(-14, -16, 70, 26), rgb(255, 40, 60))
