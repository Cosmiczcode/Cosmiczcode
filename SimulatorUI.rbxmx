			Padding = UDim.new(0, 14),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = row,
		})
		create("UIPadding", { PaddingTop = UDim.new(0, 10), Parent = row })
		return row
	end

	local BADGES = {
		["Good Value"] = ColorSequence.new(rgb(100, 210, 255), rgb(30, 110, 235)),
		["Great Value"] = ColorSequence.new(rgb(255, 225, 70), rgb(255, 130, 20)),
		["Most Value"] = RAINBOW,
	}

	local function packCard(row, i, pack, top, bottom, emoji, amountText)
		local card = fancy("Frame", { Name = "Pack" .. i, Size = UDim2.fromOffset(202, 262), LayoutOrder = i, Parent = row },
			top, bottom)
		-- light burst
		local glow = create("Frame", merge(rect(31, 40, 140, 120), { BackgroundColor3 = WHITE, BackgroundTransparency = 0.6,
			Parent = card }))
		create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = glow })
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = glow,
		})
		icon(nil, merge(rect(16, 46, 170, 106), { Parent = card }), string.rep(emoji, math.min(i, 3)))
		if pack.Badge then
			local badge = fancy("Frame", merge(rect(10, -10, 182, 44), { Parent = card }),
				BADGES[pack.Badge] or BADGES["Good Value"], nil, { Rotation = 0, Corner = 22, Stroke = 3 })
			text(pack.Badge, merge(rect(10, 5, 162, 34), { Parent = badge }), 3)
		end
		local pill = create("Frame", {
			Position = UDim2.fromOffset(12, 160),
			Size = UDim2.fromOffset(178, 38),
			BackgroundColor3 = rgb(25, 30, 45),
			BackgroundTransparency = 0.3,
			Parent = card,
		})
		create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = pill })
		text(amountText, merge(rect(8, 3, 162, 32), { Parent = pill }), 3)
		local btn = fancy("TextButton", merge(rect(12, 204, 178, 50), { Parent = card }), GREEN_TOP, GREEN_BOTTOM)
		robuxPrice(btn, pack.Price, rect(12, 6, 154, 38))
		bind(btn, function()
			promptProduct(pack.ProductId)
		end)
	end

	if s.CashPacks and #s.CashPacks > 0 then
		divider("💵 Cash Packs")
		local row = cardRow(272)
		for i, pack in ipairs(s.CashPacks) do
			packCard(row, i, pack, rgb(130, 255, 110), rgb(25, 165, 50), "💵", "+$" .. abbreviate(pack.Amount))
		end
	end
	if s.SpeedPacks and #s.SpeedPacks > 0 then
		divider("⚡ Speed Packs")
		local row = cardRow(272)
		for i, pack in ipairs(s.SpeedPacks) do
			packCard(row, i, pack, rgb(255, 220, 70), rgb(255, 125, 20), "⚡", "+" .. abbreviate(pack.Amount) .. " Speed")
		end
	end

	-- Gamepasses
	local passList = {}
	for key, cfg in pairs(Config.GamePasses) do
		table.insert(passList, { Key = key, Cfg = cfg })
	end
	table.sort(passList, function(a, b)
		return (a.Cfg.Order or 99) < (b.Cfg.Order or 99)
	end)
	local PASS_COLORS = {
		{ rgb(80, 210, 255), rgb(30, 110, 235) },
		{ rgb(200, 120, 255), rgb(110, 40, 225) },
		{ rgb(255, 225, 70), rgb(255, 130, 20) },
		{ rgb(255, 110, 200), rgb(215, 30, 110) },
		{ rgb(130, 255, 120), rgb(30, 165, 60) },
	}
	local passCards = {}
	if #passList > 0 then
		divider("🎟️ Gamepasses")
		local row
		for idx, entry in ipairs(passList) do
			local cfg = entry.Cfg
			if (idx - 1) % 2 == 0 then
				row = cardRow(222)
			end
			local colors = PASS_COLORS[(idx - 1) % #PASS_COLORS + 1]
			local card = fancy("Frame", { Name = entry.Key, Size = UDim2.fromOffset(420, 210), LayoutOrder = idx,
				Parent = row }, colors[1], colors[2], { Rotation = 45 })
			text(cfg.Name or entry.Key, merge(rect(18, 8, 390, 52), { TextXAlignment = Enum.TextXAlignment.Left,
				Parent = card }), 4)
			local circle = create("Frame", merge(rect(18, 66, 124, 124), { BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.6, Parent = card }))
			create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = circle })
			icon(nil, merge(rect(14, 14, 96, 96), { Parent = circle }), cfg.Emoji or "⭐", cfg.Image)
			text(cfg.Description or "", merge(rect(156, 62, 250, 74), { Parent = card }), 3)
			local btn = fancy("TextButton", merge(rect(196, 142, 210, 58), { Parent = card }), GREEN_TOP, GREEN_BOTTOM)
			local price = robuxPrice(btn, cfg.Price, rect(14, 8, 182, 42))
			local owned = text("OWNED", merge(rect(14, 8, 182, 42), { Visible = false, Parent = btn }), 3)
			bind(btn, function()
				if not player:GetAttribute(cfg.Attribute) then
					promptPass(cfg.GamePassId)
				end
			end)
			passCards[entry.Key] = { Cfg = cfg, Button = btn, Price = price, Owned = owned }
		end
	end

	refreshShopPasses = function()
		for _, c in pairs(passCards) do
			local has = player:GetAttribute(c.Cfg.Attribute) == true
			c.Price.Visible = not has
			c.Owned.Visible = has
			if has then
				setGradient(c.Button, rgb(220, 220, 220), rgb(130, 130, 130))
			end
		end
	end
end

---------------------------------------------------------------------
-- INDEX WINDOW
---------------------------------------------------------------------
local refreshIndex
do
	local win = makeWindow("Index", "C", "C", 366, 203, 922, 625, rgb(120, 205, 255), rgb(35, 110, 230), "Book", "Index")

	local grid = create("ScrollingFrame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(14, 122),
		Size = UDim2.fromOffset(900, 496),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = rgb(200, 200, 200),
		Parent = win,
	})
	create("UIGridLayout", {
		CellSize = UDim2.fromOffset(200, 200),
		CellPadding = UDim2.fromOffset(25, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		Parent = grid,
	})

	local selected = Config.Rarities[1].Name
	local discovered = {}
	local catButtons = {}

	local function makeCell(item, order, isFound)
		local cell = fancy("Frame", { Name = item.Name, LayoutOrder = order, Parent = grid },
			rgb(55, 75, 55), rgb(25, 35, 25), { Stroke = 4, NoShine = true, RimTransparency = 0.65 })
		-- light burst behind the icon
		local glow = create("Frame", merge(rect(30, 18, 140, 140), {
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.6,
			Parent = cell,
		}))
		create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = glow })
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = glow,
		})

		if isFound then
			icon(nil, merge(rect(40, 22, 120, 120), { Parent = cell }), item.Emoji or "⭐", item.Image)
		else
			-- yellow "?" lucky block
			local block = fancy("Frame", merge(rect(48, 28, 104, 104), { Rotation = -8, Parent = cell }),
				rgb(255, 235, 90), rgb(245, 160, 20), { Stroke = 4, StrokeColor = rgb(120, 70, 0), Corner = 10 })
			text("?", merge(rect(14, 6, 76, 92), { Parent = block }), 4, rgb(150, 90, 0))
		end

		local name = item.Name
		if not isFound and not Config.ShowUndiscoveredNames then
			name = "???"
		end
		text(name, merge(rect(8, 148, 184, 42), { Parent = cell }), 3)
	end

	refreshIndex = function(newDiscovered)
		if newDiscovered then
			discovered = newDiscovered
		end
		for _, child in ipairs(grid:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local order = 0
		for _, item in ipairs(Config.Items) do
			if item.Rarity == selected then
				order += 1
				makeCell(item, order, discovered[item.Name] == true)
			end
		end
		for rarityName, btn in pairs(catButtons) do
			local isSel = rarityName == selected
			btn:FindFirstChildOfClass("UIStroke").Color = isSel and WHITE or BLACK
		end
		grid.CanvasPosition = Vector2.zero
	end

	-- category column (sits just right of the window)
	for i, r in ipairs(Config.Rarities) do
		local b = fancy("TextButton", merge(rect(936, 112 + (i - 1) * 83, 258, 70), { Name = r.Name, Parent = win }),
			r.Top, r.Bottom)
		text(r.Name, merge(rect(12, 8, 234, 54), { Parent = b }), 4)
		catButtons[r.Name] = b
		bind(b, function()
			selected = r.Name
			refreshIndex()
		end)
	end

	refreshIndex()
end

---------------------------------------------------------------------
-- DAILY REWARDS WINDOW
---------------------------------------------------------------------
local refreshDaily
do
	local win = makeWindow("DailyRewards", "C", "C", 366, 203, 1104, 625, rgb(120, 205, 255), rgb(35, 110, 230),
		"Calendar", "Daily Rewards")

	local claimAll = fancy("TextButton", merge(rect(749, 16, 245, 72), { Name = "ClaimAll", Parent = win }),
		rgb(255, 215, 60), rgb(240, 130, 15))
	text("CLAIM ALL", merge(rect(14, 10, 217, 52), { Parent = claimAll }), 4)

	local dayStyle = {
		{ rgb(140, 220, 255), rgb(40, 140, 240) },
		{ rgb(140, 220, 255), rgb(40, 140, 240) },
		{ rgb(140, 220, 255), rgb(40, 140, 240) },
		{ rgb(220, 110, 255), rgb(140, 35, 230) },
		{ rgb(220, 110, 255), rgb(140, 35, 230) },
		{ rgb(255, 235, 70), rgb(255, 145, 20) },
	}
	local STATE_STYLE = {
		CLAIMED = { rgb(220, 220, 220), rgb(130, 130, 130) },
		CLAIM = { rgb(150, 255, 90), rgb(40, 190, 30) },
		LOCKED = { rgb(255, 80, 95), rgb(205, 15, 40) },
	}

	local cards = {}
	local snapshot = nil

	local function makeCard(day, x, y, w, h, top, bottom, big)
		local reward = Config.DailyRewards[day] or { Name = "ITEM NAME!" }
		local card = fancy("Frame", merge(rect(x, y, w, h), { Name = "Day" .. day, Parent = win }), top, bottom,
			{ Rotation = big and 45 or 90 })
		text("DAY " .. day, merge(rect(10, big and 12 or 4, w - 20, big and 80 or 50), {
			TextColor3 = big and rgb(255, 225, 60) or WHITE,
			Parent = card,
		}), 4)
		if big then
			icon("Crate", merge(rect(20, 110, w - 40, 190), { Parent = card }), nil, reward.Image)
			text(reward.Name, merge(rect(14, 300, w - 28, 90), { Parent = card }), 4)
		else
			icon("Crate", merge(rect(50, 50, w - 100, 92), { Parent = card }), nil, reward.Image)
			text(reward.Name, merge(rect(10, 128, w - 20, 38), { Parent = card }), 3)
		end
		local btnY = big and 392 or 168
		local btn = fancy("TextButton", merge(rect(26, btnY, w - 52, 54), { Name = "Status", Parent = card }),
			STATE_STYLE.LOCKED[1], STATE_STYLE.LOCKED[2])
		local label = text("LOCKED", merge(rect(10, 6, w - 72, 42), { Parent = btn }), 3)
		cards[day] = { Button = btn, Label = label }
		bind(btn, function()
			if snapshot and label.Text == "CLAIM" then
				local result = Remotes.ClaimDaily:InvokeServer(day)
				if result then
					refreshDaily(result)
				end
			end
		end)
		return card
	end

	for day = 1, 6 do
		local col = (day - 1) % 3
		local row = math.floor((day - 1) / 3)
		local st = dayStyle[day]
		makeCard(day, 27 + col * 266, 138 + row * 234, 252, 222, st[1], st[2], false)
	end
	local day7 = makeCard(7, 824, 138, 252, 456, RAINBOW, nil, true)
	-- "OP" sticker
	text("OP", merge(rect(186, -30, 100, 64), {
		Rotation = 22,
		TextColor3 = rgb(255, 40, 90),
		Parent = day7,
	}), 4, WHITE)

	local function stateFor(data, day)
		if data.Claimed[tostring(day)] then
			return "CLAIMED"
		elseif day <= data.Unlocked then
			return "CLAIM"
		end
		return "LOCKED"
	end

	refreshDaily = function(data)
		snapshot = data
		if not data or not data.Daily then
			return
		end
		local anyClaimable = false
		for day, c in pairs(cards) do
			local state = stateFor(data.Daily, day)
			c.Label.Text = state
			local style = STATE_STYLE[state]
			setGradient(c.Button, style[1], style[2])
			if state == "CLAIM" then
				anyClaimable = true
			end
		end
		dailyBadge.Visible = anyClaimable
		claimAll.Visible = anyClaimable
	end

	bind(claimAll, function()
		local result = Remotes.ClaimDaily:InvokeServer("all")
		if result then
			refreshDaily(result)
		end
	end)
end

---------------------------------------------------------------------
-- Shared row builder for list windows (Upgrades, Passes)
---------------------------------------------------------------------
local function listScroll(win)
	local scroll = create("ScrollingFrame", {
		Name = "Content",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(18, 128),
		Size = UDim2.fromOffset(890, 485),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = rgb(200, 200, 200),
		Parent = win,
	})
	create("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		Parent = scroll,
	})
	return scroll
end

local function listRow(scroll, order, name, description, emoji, image, top, bottom)
	local row = fancy("Frame", { Name = name, Size = UDim2.fromOffset(864, 120), LayoutOrder = order, Parent = scroll },
		rgb(75, 85, 100), rgb(35, 40, 50), { NoShine = true, RimTransparency = 0.7 })
	local box = fancy("Frame", merge(rect(12, 12, 96, 96), { Parent = row }), top, bottom, { Stroke = 3 })
	icon(nil, merge(rect(10, 8, 76, 80), { Parent = box }), emoji, image)
	text(name, merge(rect(124, 8, 460, 48), { TextXAlignment = Enum.TextXAlignment.Left, Parent = row }), 4)
	text(description or "", merge(rect(124, 56, 460, 32), {
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = rgb(215, 215, 215),
		Parent = row,
	}), 3)
	local sub = text("", merge(rect(124, 88, 460, 26), {
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = rgb(255, 205, 40),
		Parent = row,
	}), 3)
	local btn = fancy("TextButton", merge(rect(618, 24, 228, 72), { Name = "Buy", Parent = row }),
		rgb(170, 255, 90), rgb(50, 190, 30))
	local btnText = text("", merge(rect(12, 8, 204, 56), { Parent = btn }), 4)
	return row, sub, btn, btnText
end

local GREEN = { rgb(170, 255, 90), rgb(50, 190, 30) }
local GRAY = { rgb(220, 220, 220), rgb(130, 130, 130) }

local function flash(label, msg, restore)
	label.Text = msg
	task.delay(1.2, restore)
end

---------------------------------------------------------------------
-- UPGRADES WINDOW
---------------------------------------------------------------------
local refreshUpgrades
do
	local win = makeWindow("Upgrades", "C", "C", 456, 203, 922, 625, rgb(190, 255, 90), rgb(60, 185, 30),
		"Upgrade", "Upgrades")
	local scroll = listScroll(win)
	local rows = {}
	local levels = {}

	refreshUpgrades = function(data)
		if data and data.Upgrades then
			levels = data.Upgrades
		end
		for _, up in ipairs(Config.Upgrades) do
			local r = rows[up.Id]
			local lv = levels[up.Id] or 0
			r.Sub.Text = "Level " .. lv .. " / " .. up.MaxLevel
			if lv >= up.MaxLevel then
				r.Text.Text = "MAX"
				setGradient(r.Button, GRAY[1], GRAY[2])
			else
				r.Text.Text = "$" .. formatNumber(Config.UpgradeCost(up, lv))
				setGradient(r.Button, GREEN[1], GREEN[2])
			end
		end
	end

	for i, up in ipairs(Config.Upgrades) do
		local _, sub, btn, btnText = listRow(scroll, i, up.Name, up.Description, up.Emoji, up.Image,
			rgb(190, 255, 90), rgb(60, 185, 30))
		rows[up.Id] = { Sub = sub, Button = btn, Text = btnText }
		bind(btn, function()
			local data, err = Remotes:WaitForChild("BuyUpgrade"):InvokeServer(up.Id)
			if data then
				applyData(data)
			end
			if err then
				flash(btnText, err, function()
					refreshUpgrades()
				end)
			end
		end)
	end
	refreshUpgrades()
end

---------------------------------------------------------------------
-- PASSES WINDOW
---------------------------------------------------------------------
local refreshPasses
do
	local win = makeWindow("Pass", "C", "C", 456, 203, 922, 625, rgb(255, 235, 90), rgb(255, 160, 20), "Pass", "Passes")
	local scroll = listScroll(win)
	local ordered = {}
	for key, cfg in pairs(Config.GamePasses) do
		table.insert(ordered, { Key = key, Cfg = cfg })
	end
	table.sort(ordered, function(a, b)
		return (a.Cfg.Order or 99) < (b.Cfg.Order or 99)
	end)

	local rows = {}
	for i, entry in ipairs(ordered) do
		local cfg = entry.Cfg
		local _, sub, btn, btnText = listRow(scroll, i, cfg.Name or entry.Key, cfg.Description, cfg.Emoji, cfg.Image,
			rgb(255, 235, 90), rgb(255, 160, 20))
		btnText.Visible = false
		local price = robuxPrice(btn, cfg.Price, rect(20, 12, 188, 48))
		sub.Text = "Game Pass"
		rows[entry.Key] = { Button = btn, Text = btnText, Price = price, Cfg = cfg }
		bind(btn, function()
			if not player:GetAttribute(cfg.Attribute) then
				promptPass(cfg.GamePassId)
			end
		end)
	end

	refreshPasses = function()
		for _, r in pairs(rows) do
			local owned = player:GetAttribute(r.Cfg.Attribute) == true
			r.Price.Visible = not owned
			r.Text.Visible = owned
			r.Text.Text = "OWNED"
			local style = owned and GRAY or GREEN
			setGradient(r.Button, style[1], style[2])
		end
	end
	refreshPasses()
end

---------------------------------------------------------------------
-- REBIRTH WINDOW
---------------------------------------------------------------------
local refreshRebirth
do
	local win = makeWindow("Rebirth", "C", "C", 567, 253, 700, 520, rgb(225, 110, 255), rgb(130, 35, 230),
		"Rebirth", "Rebirth")
	local countText = text("", merge(rect(40, 135, 620, 60), { Parent = win }), 4)
	local costText = text("", merge(rect(40, 205, 620, 56), { TextColor3 = rgb(110, 255, 70), Parent = win }), 4)
	text(Config.Rebirth.RewardText, merge(rect(40, 272, 620, 44), { TextColor3 = rgb(255, 205, 40), Parent = win }), 3)
	text(Config.Rebirth.WarningText, merge(rect(40, 322, 620, 38), { TextColor3 = rgb(255, 90, 100), Parent = win }), 3)

	local btn = fancy("TextButton", merge(rect(200, 395, 300, 90), { Name = "DoRebirth", Parent = win }),
		rgb(225, 110, 255), rgb(130, 35, 230))
	local btnText = text("REBIRTH", merge(rect(14, 10, 272, 70), { Parent = btn }), 4)
	bind(btn, function()
		local ok, err = Remotes:WaitForChild("Rebirth"):InvokeServer()
		if ok then
			flash(btnText, "REBIRTHED!", function()
				btnText.Text = "REBIRTH"
			end)
		elseif err then
			flash(btnText, err, function()
				btnText.Text = "REBIRTH"
			end)
		end
	end)

	refreshRebirth = function()
		local r = getStat(S.Rebirths) or 0
		countText.Text = "Rebirths: " .. formatNumber(r)
		costText.Text = "Cost: $" .. formatNumber(Config.RebirthCost(r))
	end
	refreshRebirth()
end

---------------------------------------------------------------------
-- Data from server
---------------------------------------------------------------------
applyData = function(data)
	if not data then
		return
	end
	refreshDaily(data)
	refreshIndex(data.Discovered or {})
	refreshUpgrades(data)
end

Remotes.DataUpdated.OnClientEvent:Connect(applyData)
task.spawn(function()
	local ok, data = pcall(function()
		return Remotes.GetData:InvokeServer()
	end)
	if ok then
		applyData(data)
	end
end)

---------------------------------------------------------------------
-- Live HUD values
---------------------------------------------------------------------
task.spawn(function()
	while gui.Parent do
		rebirthText.Text = formatNumber(getStat(S.Rebirths) or 0)
		moneyText.Text = "$" .. abbreviate(getStat(S.Currency) or 0)
		speedText.Text = abbreviate(getStat("Speed") or 0) .. " Speed"
		friendText.Text = "Friend Boost: +" .. tostring(getStat(S.FriendBoost) or 0) .. "%"
		multText.Text = "x" .. tostring(getStat(S.Multiplier) or 1) .. " Multiplier"

		local level = getStat(S.Level) or 1
		local xp = getStat(S.XP) or 0
		local xpMax = getStat(S.XPMax) or 100
		levelText.Text = "Level " .. formatNumber(level)
		xpText.Text = formatNumber(xp) .. "/" .. formatNumber(xpMax) .. " XP"
		xpFill.Size = UDim2.fromScale(math.clamp(xp / math.max(xpMax, 1), 0, 1), 1)

		for statKey, info in pairs(boostTexts) do
			local v = getStat(S[statKey])
			info.Label.Text = v and ("X" .. tostring(v)) or info.Default
		end
		refreshRebirth()
		refreshPasses()
		refreshShopPasses()
		task.wait(0.25)
	end
end)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX3"><Properties><string name="Name">SimUIServer</string><ProtectedString name="Source"><![CDATA[--[[
	SimUIServer  (Script -> ServerScriptService)

	- Saves daily reward progress + discovered Index items (DataStore)
	- Validates and grants daily reward claims
	- Handles Developer Product receipts for the Shop / Level buttons
	- Sets X2Money / X2Luck attributes for game pass owners
	- My Base teleport, Upgrades purchases and Rebirths

	Hooks for your own server scripts (created in ServerStorage):
	  SimUI_DiscoverItem  (BindableEvent)  :Fire(player, "Item Name")
	  SimUI_GrantReward   (BindableEvent)  .Event(player, reward)
	      reward = a DailyRewards[n].Reward table, or for purchases
	      { Type = "Product", Key = "ExclusiveCrate3" | "ExclusiveCrate1" | "StarterPack" }
	      { Type = "Levels", Amount = 5 }
	  SimUI_GetData       (BindableFunction) :Invoke(player) -> data table
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("SimUIConfig"))

---------------------------------------------------------------------
-- Remotes / hooks
---------------------------------------------------------------------
local function make(className, name, parent)
	local existing = parent:FindFirstChild(name)
	if existing then
		return existing
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = parent
	return inst
end

local remotes = make("Folder", "SimUIRemotes", ReplicatedStorage)
local GetData = make("RemoteFunction", "GetData", remotes)
local ClaimDaily = make("RemoteFunction", "ClaimDaily", remotes)
local DataUpdated = make("RemoteEvent", "DataUpdated", remotes)
local GoToBase = make("RemoteEvent", "GoToBase", remotes)
local BuyUpgrade = make("RemoteFunction", "BuyUpgrade", remotes)
local RebirthRemote = make("RemoteFunction", "Rebirth", remotes)

local DiscoverItem = make("BindableEvent", "SimUI_DiscoverItem", ServerStorage)
local GrantReward = make("BindableEvent", "SimUI_GrantReward", ServerStorage)
local GetDataHook = make("BindableFunction", "SimUI_GetData", ServerStorage)

---------------------------------------------------------------------
-- Data
---------------------------------------------------------------------
local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("SimUI_v1")
	end)
	if ok then
		store = result
	else
		warn("[SimUI] DataStore unavailable (enable Studio API access to save in Studio):", result)
	end
end

local sessions = {} -- [player] = data
local DAYS = #Config.DailyRewards

local function defaultData()
	return {
		Daily = { Claimed = {}, Unlocked = 0, LastDay = -1 },
		Discovered = {},
		Upgrades = {},
	}
end

local function today()
	return math.floor(os.time() / 86400)
end

local function allClaimed(daily)
	for d = 1, DAYS do
		if not daily.Claimed[tostring(d)] then
			return false
		end
	end
	return true
end

-- Unlock the next day if this is a new calendar day
local function tickDaily(data)
	local daily = data.Daily
	local now = today()
	if daily.LastDay == now then
		return false
	end
	local missed = daily.LastDay ~= -1 and now - daily.LastDay > 1
	if allClaimed(daily) or (missed and Config.ResetStreakOnMiss) then
		daily.Claimed = {}
		daily.Unlocked = 0
	end
	daily.Unlocked = math.min(daily.Unlocked + 1, DAYS)
	daily.LastDay = now
	return true
end

local function save(player)
	local data = sessions[player]
	if not data or not store then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync("u" .. player.UserId, data)
	end)
	if not ok then
		warn("[SimUI] Save failed for", player.Name, err)
	end
end

local function load(player)
	local data
	if store then
		local ok, result = pcall(function()
			return store:GetAsync("u" .. player.UserId)
		end)
		if ok then
			data = result
		else
			warn("[SimUI] Load failed for", player.Name, result)
		end
	end
	data = data or defaultData()
	data.Daily = data.Daily or defaultData().Daily
	data.Daily.Claimed = data.Daily.Claimed or {}
	data.Discovered = data.Discovered or {}
	data.Upgrades = data.Upgrades or {}
	tickDaily(data)
	sessions[player] = data
	return data
end

local function waitForData(player)
	local t = 0
	while not sessions[player] and player.Parent and t < 15 do
		t += task.wait(0.1)
	end
	return sessions[player]
end

---------------------------------------------------------------------
-- Granting
---------------------------------------------------------------------
local function addStat(player, statName, amount)
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(statName)
	if v and (v:IsA("IntValue") or v:IsA("NumberValue")) then
		v.Value += amount
	else
		player:SetAttribute(statName, (player:GetAttribute(statName) or 0) + amount)
	end
end

local function findStat(player, statName)
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(statName)
	if v and (v:IsA("IntValue") or v:IsA("NumberValue")) then
		return v
	end
	return nil
end

local function getStat(player, statName)
	local v = findStat(player, statName)
	if v then
		return v.Value
	end
	return player:GetAttribute(statName) or 0
end

local function setStat(player, statName, value)
	local v = findStat(player, statName)
	if v then
		v.Value = value
	else
		player:SetAttribute(statName, value)
	end
end

local function grant(player, reward)
	if reward.Type == "Stat" then
		addStat(player, reward.Stat, reward.Amount)
	elseif reward.Type == "Levels" then
		addStat(player, Config.Stats.Level, reward.Amount)
	end
	GrantReward:Fire(player, reward)
end

---------------------------------------------------------------------
-- Remote handlers
---------------------------------------------------------------------
GetData.OnServerInvoke = function(player)
	local data = waitForData(player)
	if data and tickDaily(data) then
		save(player)
	end
	return data
end

GetDataHook.OnInvoke = function(player)
	return sessions[player]
end

local claimDebounce = {}
ClaimDaily.OnServerInvoke = function(player, which)
	local data = sessions[player]
	if not data or claimDebounce[player] then
		return data
	end
	claimDebounce[player] = true
	tickDaily(data)
	local daily = data.Daily

	local days = {}
	if which == "all" then
		for d = 1, daily.Unlocked do
			table.insert(days, d)
		end
	elseif typeof(which) == "number" and which == math.floor(which) and which >= 1 and which <= daily.Unlocked then
		days = { which }
	end

	local any = false
	for _, d in ipairs(days) do
		local key = tostring(d)
		if not daily.Claimed[key] then
			daily.Claimed[key] = true
			any = true
			local reward = Config.DailyRewards[d] and Config.DailyRewards[d].Reward
			if reward then
				grant(player, reward)
			end
		end
	end
	if any then
		task.spawn(save, player)
	end
	claimDebounce[player] = nil
	return data
end

DiscoverItem.Event:Connect(function(player, itemName)
	local data = sessions[player]
	if data and typeof(itemName) == "string" and not data.Discovered[itemName] then
		data.Discovered[itemName] = true
		DataUpdated:FireClient(player, data)
	end
end)

---------------------------------------------------------------------
-- Purchases
---------------------------------------------------------------------
local products = {}
local function registerProduct(id, info)
	if id and id ~= 0 then
		products[id] = info
	end
end
local shop = Config.Shop
registerProduct(shop.ExclusiveCrate.BuyMany.ProductId, { Type = "Product", Key = shop.ExclusiveCrate.BuyMany.Key })
registerProduct(shop.ExclusiveCrate.BuyOne.ProductId, { Type = "Product", Key = shop.ExclusiveCrate.BuyOne.Key })
registerProduct(shop.StarterPack.ProductId, { Type = "Product", Key = shop.StarterPack.Key })
for _, pack in ipairs(shop.CashPacks or {}) do
	registerProduct(pack.ProductId, { Type = "Stat", Stat = Config.Stats.Currency, Amount = pack.Amount })
end
for _, pack in ipairs(shop.SpeedPacks or {}) do
	registerProduct(pack.ProductId, { Type = "Stat", Stat = "Speed", Amount = pack.Amount })
end
if shop.TreadmillSkip then
	registerProduct(shop.TreadmillSkip.ProductId, { Type = "Product", Key = shop.TreadmillSkip.Key })
end
for _, lp in ipairs(Config.LevelProducts) do
	registerProduct(lp.ProductId, { Type = "Levels", Amount = lp.Levels })
end

if Config.HandleReceipts then
	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		local info = products[receipt.ProductId]
		if not player or not info then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local ok, err = pcall(grant, player, info)
		if not ok then
			warn("[SimUI] Grant failed:", err)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end

local function refreshPasses(player)
	for _, pass in pairs(Config.GamePasses) do
		if pass.GamePassId ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.GamePassId)
			end)
			if ok and owns then
				player:SetAttribute(pass.Attribute, true)
			end
		end
	end
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	for _, pass in pairs(Config.GamePasses) do
		if pass.GamePassId == passId then
			player:SetAttribute(pass.Attribute, true)
		end
	end
end)

---------------------------------------------------------------------
-- Upgrades
---------------------------------------------------------------------
local upgradesById = {}
for _, up in ipairs(Config.Upgrades or {}) do
	upgradesById[up.Id] = up
end

local function applyUpgrades(player)
	local data = sessions[player]
	if not data then
		return
	end
	for id, up in pairs(upgradesById) do
		local lv = data.Upgrades[id] or 0
		player:SetAttribute("Upgrade_" .. id, lv)
		player:SetAttribute(id .. "Bonus", lv * up.PerLevel)
	end
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		for id, up in pairs(upgradesById) do
			local bonus = (data.Upgrades[id] or 0) * up.PerLevel
			if up.Effect == "WalkSpeed" then
				hum.WalkSpeed = game:GetService("StarterPlayer").CharacterWalkSpeed + bonus
					+ (player:GetAttribute("TreadmillSpeedBonus") or 0)
			elseif up.Effect == "JumpPower" then
				hum.UseJumpPower = true
				hum.JumpPower = game:GetService("StarterPlayer").CharacterJumpPower + bonus
			end
		end
	end
end

local busy = {}
BuyUpgrade.OnServerInvoke = function(player, id)
	local data = sessions[player]
	local up = typeof(id) == "string" and upgradesById[id]
	if not data or not up then
		return data, "Error"
	end
	if busy[player] then
		return data, nil
	end
	busy[player] = true
	local lv = data.Upgrades[id] or 0
	local err = nil
	if lv >= up.MaxLevel then
		err = "MAX"
	else
		local cost = Config.UpgradeCost(up, lv)
		local cash = getStat(player, Config.Stats.Currency)
		if cash < cost then
			err = "Need $" .. math.ceil(cost - cash)
		else
			setStat(player, Config.Stats.Currency, cash - cost)
			data.Upgrades[id] = lv + 1
			applyUpgrades(player)
			GrantReward:Fire(player, { Type = "Upgrade", Id = id, Level = lv + 1 })
			task.spawn(save, player)
		end
	end
	busy[player] = nil
	return data, err
end

---------------------------------------------------------------------
-- Rebirth
---------------------------------------------------------------------
RebirthRemote.OnServerInvoke = function(player)
	if not Config.Rebirth.Enabled then
		GrantReward:Fire(player, { Type = "RebirthRequest" })
		return false, nil
	end
	if busy[player] then
		return false, nil
	end
	busy[player] = true
	local rebirths = getStat(player, Config.Stats.Rebirths)
	local cost = Config.RebirthCost(rebirths)
	local ok, err = false, nil
	if getStat(player, Config.Stats.Currency) < cost then
		err = "Need more Cash!"
	else
		for _, statName in ipairs(Config.Rebirth.ResetStats) do
			setStat(player, statName, 0)
		end
		setStat(player, Config.Stats.Rebirths, rebirths + 1)
		GrantReward:Fire(player, { Type = "Rebirth", Rebirths = rebirths + 1 })
		ok = true
	end
	busy[player] = nil
	return ok, err
end

---------------------------------------------------------------------
-- My Base teleport
---------------------------------------------------------------------
local function ownedBy(obj, player)
	if obj.Name == player.Name or obj.Name == player.Name .. "'s Base" or obj.Name == player.Name .. "Base" then
		return true
	end
	local function matches(v)
		return v == player or v == player.UserId or v == player.Name or v == tostring(player.UserId)
			or v == player.DisplayName and v ~= ""
	end
	for _, key in ipairs(Config.Base.OwnerNames) do
		local attr = obj:GetAttribute(key)
		if attr ~= nil and matches(attr) then
			return true
		end
		local child = obj:FindFirstChild(key)
		if child and child:IsA("ValueBase") and matches(child.Value) then
			return true
		end
	end
	return false
end

local function findBase(player)
	if Config.Base.Find then
		local ok, result = pcall(Config.Base.Find, player)
		if ok and result then
			return result
		end
	end
	for _, folderName in ipairs(Config.Base.FolderNames) do
		local folder = workspace:FindFirstChild(folderName)
		if folder then
			if ownedBy(folder, player) then
				return folder
			end
			for _, base in ipairs(folder:GetChildren()) do
				if ownedBy(base, player) then
					return base
				end
			end
		end
	end
	-- last resort: any model in Workspace with a matching owner tag
	for _, obj in ipairs(workspace:GetChildren()) do
		if obj:IsA("Model") and obj ~= player.Character and not Players:GetPlayerFromCharacter(obj)
			and ownedBy(obj, player) then
			return obj
		end
	end
	return nil
end

local function toCFrame(target)
	if typeof(target) == "CFrame" then
		return target
	end
	if typeof(target) ~= "Instance" then
		return nil
	end
	for _, partName in ipairs(Config.Base.TeleportPartNames) do
		local p = target:FindFirstChild(partName, true)
		if p and p:IsA("BasePart") then
			return p.CFrame
		end
	end
	if target:IsA("BasePart") then
		return target.CFrame
	end
	if target:IsA("Model") or target:IsA("Folder") then
		local ok, cf = pcall(function()
			if target:IsA("Model") then
				return target:GetPivot()
			end
			local any = target:FindFirstChildWhichIsA("BasePart", true)
			return any and any.CFrame
		end)
		if ok then
			return cf
		end
	end
	return nil
end

local lastTeleport = {}
GoToBase.OnServerEvent:Connect(function(player)
	if lastTeleport[player] and os.clock() - lastTeleport[player] < 1 then
		return
	end
	lastTeleport[player] = os.clock()
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then
		return
	end
	local cf = toCFrame(findBase(player))
	if not cf then
		-- fall back to the player's spawn
		local spawn = player.RespawnLocation or workspace:FindFirstChildWhichIsA("SpawnLocation", true)
		cf = spawn and spawn.CFrame
		warn("[SimUI] Couldn't find " .. player.Name .. "'s base - set Config.Base in SimUIConfig. Sent to spawn.")
	end
	if cf then
		char:PivotTo(CFrame.new(cf.Position + Config.Base.Offset))
	end
end)

---------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------
local function onJoin(player)
	local data = load(player)
	refreshPasses(player)
	applyUpgrades(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.2)
		applyUpgrades(player)
	end)
	DataUpdated:FireClient(player, data)
end

Players.PlayerAdded:Connect(onJoin)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onJoin, p)
end

Players.PlayerRemoving:Connect(function(player)
	save(player)
	sessions[player] = nil
	claimDebounce[player] = nil
	busy[player] = nil
	lastTeleport[player] = nil
end)

game:BindToClose(function()
	if RunService:IsStudio() and not store then
		return
	end
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(save, p)
	end
	task.wait(3)
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">TreadmillSkins</string><ProtectedString name="Source"><![CDATA[--[[
	TreadmillSkins  (ModuleScript -> ReplicatedStorage)

	Builds 12 themed treadmill models out of plain Parts (no uploads needed):

	  Basic, Jungle, Tech, Hacker, Inferno, Frost,
	  Golden, Alien, Candy, Lucky, Toxic, Ocean

	EASIEST: paste this into Studio's Command Bar (View > Command Bar):

		require(game.ReplicatedStorage.TreadmillSkins).Install()

	That creates:
	  ServerStorage.TreadmillSkins   - one template model per skin
	  Workspace.TreadmillShowcase    - all 12 on a two-row display

	Other functions:
	  .Build(skinName, cframe?)        -> Model (not parented)
	  .Swap(oldTreadmill, skinName)    -> Model. Replaces an existing treadmill
	                                      in place, keeping its name, attributes
	                                      and any scripts / values / prompts.
	  .SwapAll(folder, skinName)       -> reskins every Model in a folder
	  .Skins                           -> list of skin names in display order

	Each model's PrimaryPart is "Deck" and it has a "Belt" part (the running
	surface) plus an invisible "Hitbox" covering the belt for touch checks.
]]

local CollectionService = game:GetService("CollectionService")

local TreadmillSkins = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local rgb = Color3.fromRGB
local M = Enum.Material

TreadmillSkins.Skins = {
	"Basic", "Jungle", "Tech", "Hacker", "Inferno", "Frost",
	"Golden", "Alien", "Candy", "Lucky", "Toxic", "Ocean",
}

---------------------------------------------------------------------
-- Part helpers (everything is built around the origin, then pivoted)
---------------------------------------------------------------------
local function P(model, name, size, cframe, color, material, props)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = model
	return p
end

local function wedge(model, name, size, cframe, color, material)
	local w = Instance.new("WedgePart")
	w.Name = name
	w.Anchored = true
	w.CanCollide = false
	w.Size = size
	w.CFrame = cframe
	w.Color = color
	w.Material = material or M.SmoothPlastic
	w.Parent = model
	return w
end

-- vertical cylinder standing on `pos` (pos = bottom centre)
local function cylUp(model, name, pos, height, diameter, color, material)
	return P(model, name, V(height, diameter, diameter), CF(pos + V(0, height / 2, 0)) * ANG(0, 0, rad(90)),
		color, material, { Shape = Enum.PartType.Cylinder })
end

-- disc facing sideways (axis = X), like a wheel
local function disc(model, name, cframe, thickness, diameter, color, material)
	return P(model, name, V(thickness, diameter, diameter), cframe, color, material, { Shape = Enum.PartType.Cylinder })
end

local function ball(model, name, pos, d, color, material, props)
	local t = { Shape = Enum.PartType.Ball }
	if props then
		for k, v in pairs(props) do
			t[k] = v
		end
	end
	return P(model, name, V(d, d, d), CF(pos), color, material, t)
end

local function light(part, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range or 12
	l.Brightness = brightness or 2
	l.Parent = part
	return l
end

local function particles(part, color, opts)
	opts = opts or {}
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.LightEmission = opts.LightEmission or 0.8
	e.Rate = opts.Rate or 6
	e.Lifetime = NumberRange.new(opts.Life or 1.2, (opts.Life or 1.2) * 1.6)
	e.Speed = NumberRange.new(opts.Speed or 1.5, (opts.Speed or 1.5) * 2)
	e.SpreadAngle = Vector2.new(opts.Spread or 180, opts.Spread or 180)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, opts.Size or 0.35),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Transparency = NumberSequence.new(0.1, 1)
	e.Acceleration = opts.Accel or V(0, 1, 0)
	if opts.Texture then
		e.Texture = opts.Texture
	end
	e.Parent = part
	return e
end

local function label(part, face, text, color, bg)
	local g = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 50
	g.LightInfluence = 0
	g.Parent = part
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = bg and 0 or 1
	t.BackgroundColor3 = bg or Color3.new()
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextStrokeTransparency = 0
	t.Parent = g
	return g
end

local function allFaces(part, text, color)
	for _, face in ipairs(Enum.NormalId:GetEnumItems()) do
		label(part, face, text, color)
	end
end

local function rng(seed)
	return Random.new(seed)
end

-- Marks a part for the client animator (TreadmillClient):
--   Spin (world Y), Bob, Float (bob+spin), Roll (own X axis), Sway,
--   Pulse (neon glow), Belt (scrolling slats), Orbit (around FxCenter)
local function fx(part, kind, speed, amp, phase)
	part:SetAttribute("Fx", kind)
	part:SetAttribute("FxSpeed", speed or 1)
	part:SetAttribute("FxAmp", amp or 0.5)
	part:SetAttribute("FxPhase", phase or 0)
	CollectionService:AddTag(part, "TreadFx")
	return part
end
TreadmillSkins.fx = fx

---------------------------------------------------------------------
-- The shared treadmill body
--   faces -Z (console end); the runner stands on +Z side of the belt
--   footprint ~6 x 11.5 studs, ~8 studs tall
---------------------------------------------------------------------
local function buildBase(m, t)
	local frameMat, trimMat = t.Material or M.SmoothPlastic, t.TrimMaterial or M.SmoothPlastic

	local deck = P(m, "Deck", V(6, 1, 11), CF(0, 0.5, 0), t.Frame, frameMat, { CanCollide = true })
	P(m, "Belt", V(4.6, 0.3, 10), CF(0, 1.1, 0.35), t.Belt, M.SmoothPlastic, { CanCollide = true })
	-- belt slats
	for i = 0, 7 do
		fx(P(m, "Slat", V(4.6, 0.05, 0.12), CF(0, 1.27, -4.2 + i * 1.1), t.Belt:Lerp(Color3.new(1, 1, 1), 0.15)),
			"Belt", 2.5, 1.1)
	end
	P(m, "RailL", V(0.8, 0.8, 11), CF(-2.7, 1.25, 0), t.Trim, trimMat)
	P(m, "RailR", V(0.8, 0.8, 11), CF(2.7, 1.25, 0), t.Trim, trimMat)
	P(m, "Motor", V(6, 1.6, 1.4), CF(0, 1.2, -5.3), t.Frame, frameMat)
	P(m, "Roller", V(6.2, 0.7, 0.7), CF(0, 0.75, 5.4), t.Trim, trimMat)

	for _, x in ipairs({ -2.6, 2.6 }) do
		P(m, "Post", V(0.75, 5.6, 0.75), CF(x, 4.2, -4.9) * ANG(rad(-8), 0, 0), t.Frame, frameMat)
		P(m, "Handle", V(0.5, 0.5, 3.2), CF(x, 4.9, -3.3), t.Trim, trimMat)
		P(m, "HandleCap", V(0.6, 0.6, 0.6), CF(x, 4.9, -1.75), t.Accent or t.Trim, trimMat)
	end

	local console = P(m, "Console", V(6.2, 2.6, 1), CF(0, 7.2, -5.45) * ANG(rad(-25), 0, 0), t.Frame, frameMat)
	P(m, "ConsoleTrim", V(6.4, 0.35, 1.1), console.CFrame * CF(0, 1.4, 0), t.Trim, trimMat)
	P(m, "ConsoleLip", V(6.4, 0.35, 1.1), console.CFrame * CF(0, -1.4, 0), t.Trim, trimMat)
	-- display buttons (front face is local +Z)
	local small = { rgb(255, 220, 40), rgb(255, 150, 30), rgb(255, 220, 40), rgb(255, 150, 30) }
	for i, c in ipairs(small) do
		fx(P(m, "Button", V(1, 0.5, 0.2), console.CFrame * CF(-1.65 + (i - 1) * 1.1, 0.55, 0.55), c, M.Neon),
			"Pulse", 3, 0.7, i)
	end
	P(m, "BigRed", V(1.5, 0.9, 0.25), console.CFrame * CF(-1.6, -0.45, 0.55), rgb(235, 40, 50), M.SmoothPlastic)
	P(m, "BigGreen", V(1.5, 0.9, 0.25), console.CFrame * CF(1.6, -0.45, 0.55), rgb(60, 220, 60), M.SmoothPlastic)

	if t.Glow then
		fx(P(m, "GlowStripL", V(0.15, 0.2, 10.6), CF(-3.12, 1.25, 0), t.Glow, M.Neon), "Pulse", 2, 0.6)
		fx(P(m, "GlowStripR", V(0.15, 0.2, 10.6), CF(3.12, 1.25, 0), t.Glow, M.Neon), "Pulse", 2, 0.6)
		light(deck, t.Glow, 14, 1.5)
	end

	P(m, "Hitbox", V(4.6, 4, 10), CF(0, 3.2, 0.35), rgb(255, 255, 255), M.SmoothPlastic, {
		Transparency = 1,
		CanTouch = true,
		CanQuery = false,
	})

	m.PrimaryPart = deck
	return console
end

