<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Folder" referent="RBX0"><Properties><string name="Name">SimulatorUI</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">SimUIConfig</string><ProtectedString name="Source"><![CDATA[--[[
	SimUIConfig  (ModuleScript -> ReplicatedStorage)

	Everything you will want to change lives here: item lists, reward
	days, prices, product / game pass IDs, icon images and which
	leaderstats the HUD reads from.
]]

local Config = {}

---------------------------------------------------------------------
-- Icons
-- Paste "rbxassetid://123456" into any of these to use your own
-- uploaded image. While a value is "" the matching emoji is shown.
---------------------------------------------------------------------
Config.Icons = {
	Crate = "",
	MysteryBox = "",
	Book = "",
	Basket = "",
	Pass = "",
	Rebirth = "",
	Calendar = "",
	Gift = "",
	Cash = "",
	Clover = "",
	Shovel = "",
	Verified = "",
	Upgrade = "",
	Robux = "rbxasset://textures/ui/common/robux.png",
}

Config.Emoji = {
	Crate = "📦",
	MysteryBox = "❓",
	Book = "📘",
	Basket = "🧺",
	Pass = "🎫",
	Rebirth = "🔄",
	Calendar = "📅",
	Gift = "🎁",
	Cash = "💵",
	Clover = "🍀",
	Shovel = "🪏",
	Verified = "✅",
	Upgrade = "⏫",
	Robux = "R$",
}

---------------------------------------------------------------------
-- Stats the HUD reads. Each name is looked up in player.leaderstats
-- first, then as an attribute on the Player.
---------------------------------------------------------------------
Config.Stats = {
	Currency = "Cash",
	Rebirths = "Rebirths",
	Level = "Level",
	XP = "XP",
	XPMax = "XPMax", -- XP needed for next level (falls back to 100)
	Multiplier = "Multiplier",
	FriendBoost = "FriendBoost", -- percent number, e.g. 10 -> "+10%"
	CashBoost = "CashBoost", -- bottom-right "X1.1"
	RebirthBoost = "RebirthBoost", -- bottom-right "X1.3"
	VerifiedBoost = "VerifiedBoost", -- bottom-right "N/A"
}

---------------------------------------------------------------------
-- Rarities (Index category buttons, top to bottom)
---------------------------------------------------------------------
Config.Rarities = {
	{ Name = "Common", Top = Color3.fromRGB(240, 240, 240), Bottom = Color3.fromRGB(140, 140, 140) },
	{ Name = "Rare", Top = Color3.fromRGB(110, 215, 255), Bottom = Color3.fromRGB(25, 105, 235) },
	{ Name = "Epic", Top = Color3.fromRGB(215, 100, 255), Bottom = Color3.fromRGB(115, 25, 225) },
	{ Name = "Legendary", Top = Color3.fromRGB(255, 225, 60), Bottom = Color3.fromRGB(255, 120, 15) },
	{ Name = "Mythical", Top = Color3.fromRGB(255, 90, 150), Bottom = Color3.fromRGB(215, 15, 45) },
	{ Name = "Secret", Top = Color3.fromRGB(110, 110, 110), Bottom = Color3.fromRGB(20, 20, 20) },
}

---------------------------------------------------------------------
-- Index items. Image = "rbxassetid://..." (optional), Emoji shown
-- otherwise once the item is discovered. Undiscovered items show the
-- yellow "?" block.
--
-- Mark an item discovered from any server script with:
--   game.ServerStorage.SimUI_DiscoverItem:Fire(player, "Item Name")
---------------------------------------------------------------------
Config.ShowUndiscoveredNames = true -- false = show "???" instead

Config.Items = {
	-- { Name = "Wooden Sword", Rarity = "Common", Image = "", Emoji = "🗡️" },
}

-- Placeholder items so the Index is filled out like the preview.
-- Delete this loop once you've added your real items above.
if #Config.Items == 0 then
	for _, rarity in ipairs(Config.Rarities) do
		for i = 1, 12 do
			table.insert(Config.Items, {
				Name = rarity.Name .. " Item " .. i,
				Rarity = rarity.Name,
				Image = "",
				Emoji = "⭐",
			})
		end
	end
end

---------------------------------------------------------------------
-- Daily rewards (7 days). One new day unlocks per calendar day (UTC)
-- the player logs in. After day 7 is claimed the cycle restarts.
--
-- Reward.Type:
--   "Stat"   -> adds Amount to leaderstats[Stat] (or attribute)
--   "Custom" -> only fires ServerStorage.SimUI_GrantReward(player, reward)
-- Every reward also fires SimUI_GrantReward so you can hook in.
---------------------------------------------------------------------
Config.ResetStreakOnMiss = false -- true = missing a day restarts at Day 1

Config.DailyRewards = {
	{ Name = "ITEM NAME!", Reward = { Type = "Stat", Stat = "Cash", Amount = 500 } },
	{ Name = "ITEM NAME!", Reward = { Type = "Stat", Stat = "Cash", Amount = 1000 } },
	{ Name = "ITEM NAME!", Reward = { Type = "Stat", Stat = "Cash", Amount = 2500 } },
	{ Name = "ITEM NAME!", Reward = { Type = "Stat", Stat = "Cash", Amount = 5000 } },
	{ Name = "ITEM NAME!", Reward = { Type = "Stat", Stat = "Cash", Amount = 10000 } },
	{ Name = "ITEM NAME!", Reward = { Type = "Stat", Stat = "Cash", Amount = 25000 } },
	{ Name = "ITEM NAME!", Reward = { Type = "Custom", Id = "Day7Crate" } },
}

---------------------------------------------------------------------
-- Shop. ProductId = your Developer Product ID (Creator Dashboard ->
-- your experience -> Monetization -> Developer Products).
-- Price / OldPrice are only the numbers displayed.
---------------------------------------------------------------------
Config.Shop = {
	ExclusiveCrate = {
		Title = "Exclusive [NAME] Crate!",
		Label = "Exclusive",
		SubLabel = "[NAME] Crate",
		Odds = {
			{ Name = "Name", Chance = "65%", Color = Color3.fromRGB(255, 255, 255) },
			{ Name = "Name", Chance = "45%", Color = Color3.fromRGB(120, 255, 90) },
			{ Name = "Name", Chance = "15%", Color = Color3.fromRGB(255, 220, 60) },
			{ Name = "Name", Chance = "1%", Color = Color3.fromRGB(110, 200, 255) },
			{ Name = "Name", Chance = "0.01%", Color = Color3.fromRGB(255, 120, 230) },
		},
		BuyMany = { ProductId = 0, Price = 55, OldPrice = 87, Label = "3 Crates", Key = "ExclusiveCrate3" },
		BuyOne = { ProductId = 0, Price = 29, Label = "1 Crate", Key = "ExclusiveCrate1" },
	},
	StarterPack = {
		Title = "Limited Starter Pack!",
		CrateRarity = "Epic",
		CrateLabel = "1 [NAME] Crate",
		Contents = {
			{ Icon = "Cash", Count = "x1", Label = "15 min" },
			{ Icon = "Clover", Count = "x1", Label = "15 min" },
			{ Icon = "Shovel", Count = "x1", Label = "Name" },
		},
		ProductId = 0,
		Price = 19,
		OldPrice = 69,
		Key = "StarterPack",
	},
}

-- Game passes: used by the right side X2 buttons and the "Pass" window.
-- Owning one sets the Player attribute named in Attribute to true.
Config.GamePasses = {
	X2Money = {
		Order = 1, GamePassId = 0, Price = 9, Attribute = "X2Money",
		Name = "X2 Money", Description = "Double all money you earn", Emoji = "💵",
	},
	X2Luck = {
		Order = 2, GamePassId = 0, Price = 9, Attribute = "X2Luck",
		Name = "X2 Luck", Description = "Double your luck on every roll", Emoji = "🍀",
	},
}

---------------------------------------------------------------------
-- Old UI
-- Any ScreenGui that comes from StarterGui is hidden when the new UI
-- loads (popups your scripts create later are left alone). The Output
-- window prints every UI it hides; add a name to KeepGuis to keep it.
---------------------------------------------------------------------
Config.HideOldGuis = true
Config.KeepGuis = { "TouchGui", "Freecam", "BubbleChat", "Chat" }
Config.ExtraGuisToHide = {} -- names of old ScreenGuis made by scripts

---------------------------------------------------------------------
-- My Base button
-- Looks in these Workspace folders for a base owned by the player.
-- A base counts as theirs when it has an attribute or Value child
-- named one of OwnerNames holding the Player, UserId or Name, or when
-- the base itself is named after the player.
---------------------------------------------------------------------
Config.Base = {
	FolderNames = { "Bases", "Plots", "Tycoons", "Tycoon", "Base", "Plot", "Houses" },
	OwnerNames = { "Owner", "OwnerId", "OwnerUserId", "OwnerName", "Player", "PlayerName" },
	TeleportPartNames = { "Spawn", "SpawnPoint", "SpawnLocation", "Teleport", "TeleportPart", "TP", "Floor", "Base" },
	Offset = Vector3.new(0, 4, 0),
	-- Or write your own (server side): return a CFrame, BasePart or Model
	Find = nil, -- function(player) return workspace.Bases[...] end
}

---------------------------------------------------------------------
-- Upgrades window. Bought with the Currency stat and saved.
-- Each sets Player attributes "Upgrade_<Id>" (level) and
-- "<Id>Bonus" (level * PerLevel) for your own scripts to read.
-- Effect "WalkSpeed" / "JumpPower" is applied automatically.
---------------------------------------------------------------------
Config.Upgrades = {
	{ Id = "WalkSpeed", Name = "Walk Speed", Description = "+2 speed per level", Emoji = "👟",
		MaxLevel = 10, BaseCost = 500, CostGrowth = 1.6, PerLevel = 2, Effect = "WalkSpeed" },
	{ Id = "CashMulti", Name = "Cash Multiplier", Description = "+10% money per level", Emoji = "💵",
		MaxLevel = 20, BaseCost = 1000, CostGrowth = 1.5, PerLevel = 0.1 },
	{ Id = "Luck", Name = "Luck", Description = "+5% luck per level", Emoji = "🍀",
		MaxLevel = 10, BaseCost = 2500, CostGrowth = 1.7, PerLevel = 0.05 },
	{ Id = "JumpPower", Name = "Jump Power", Description = "+5 jump per level", Emoji = "🦘",
		MaxLevel = 10, BaseCost = 750, CostGrowth = 1.6, PerLevel = 5, Effect = "JumpPower" },
}

function Config.UpgradeCost(upgrade, level)
	return math.floor(upgrade.BaseCost * upgrade.CostGrowth ^ level)
end

---------------------------------------------------------------------
-- Rebirth window. Set Enabled = false if your game already has its
-- own rebirth system (the button then only fires SimUI_GrantReward
-- with { Type = "RebirthRequest" }).
---------------------------------------------------------------------
Config.Rebirth = {
	Enabled = true,
	BaseCost = 1000000,
	CostGrowth = 2.5,
	ResetStats = { "Cash" }, -- set to 0 on rebirth
	RewardText = "Reward: +1 Rebirth (bigger multiplier!)",
	WarningText = "Resets your Cash",
}

function Config.RebirthCost(rebirths)
	return math.floor(Config.Rebirth.BaseCost * Config.Rebirth.CostGrowth ^ rebirths)
end

-- Bottom "+5 / +10 / +25 Levels" buttons (Developer Product IDs)
Config.LevelProducts = {
	{ Levels = 5, ProductId = 0 },
	{ Levels = 10, ProductId = 0 },
	{ Levels = 25, ProductId = 0 },
}

-- Set false if your game already has its own ProcessReceipt callback
-- (Roblox only allows one). Then grant purchases yourself.
Config.HandleReceipts = true

return Config
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX2"><Properties><string name="Name">SimUIClient</string><ProtectedString name="Source"><![CDATA[--[[
	SimUIClient  (LocalScript -> StarterPlayer > StarterPlayerScripts)

	Builds the whole HUD + Shop, Index and Daily Rewards windows in code.
	Layout is drawn on a 1835 x 1032 reference canvas and scaled to fit
	every screen size, so it looks the same on PC, tablet and phone.

	Every HUD button also fires PlayerGui.SimulatorUI.ButtonClicked
	(BindableEvent) with the button name, so you can hook in extra
	behaviour from your own LocalScripts:

		local gui = player.PlayerGui:WaitForChild("SimulatorUI")
		gui.ButtonClicked.Event:Connect(function(name) print(name) end)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("SimUIConfig"))
local Remotes = ReplicatedStorage:WaitForChild("SimUIRemotes")
local S = Config.Stats

---------------------------------------------------------------------
-- Constants
---------------------------------------------------------------------
local REF_W, REF_H = 1835, 1032
local FONT = Font.fromEnum(Enum.Font.FredokaOne)
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.fromRGB(15, 15, 20)

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local STRIPES = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.48, 1),
	NumberSequenceKeypoint.new(0.481, 0.82),
	NumberSequenceKeypoint.new(0.58, 0.82),
	NumberSequenceKeypoint.new(0.581, 1),
	NumberSequenceKeypoint.new(0.64, 1),
	NumberSequenceKeypoint.new(0.641, 0.86),
	NumberSequenceKeypoint.new(0.68, 0.86),
	NumberSequenceKeypoint.new(0.681, 1),
	NumberSequenceKeypoint.new(1, 1),
})

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, rgb(190, 60, 255)),
	ColorSequenceKeypoint.new(0.3, rgb(255, 70, 170)),
	ColorSequenceKeypoint.new(0.55, rgb(255, 210, 60)),
	ColorSequenceKeypoint.new(0.8, rgb(110, 240, 90)),
	ColorSequenceKeypoint.new(1, rgb(70, 200, 255)),
})

---------------------------------------------------------------------
-- Instance helpers
---------------------------------------------------------------------
local function apply(inst, props)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				inst[k] = v
			end
		end
		if props.Parent then
			inst.Parent = props.Parent
		end
	end
	return inst
end

local function create(className, props)
	return apply(Instance.new(className), props)
end

local function merge(...)
	local out = {}
	for _, t in ipairs({ ... }) do
		for k, v in pairs(t) do
			out[k] = v
		end
	end
	return out
end

local function tween(inst, goal, time, style, dir)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		goal
	)
	t:Play()
	return t
end

-- Rect from top-left coordinates inside a parent (anchor = centre so
-- UIScale pop animations scale from the middle).
local function rect(x, y, w, h)
	return {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x + w / 2, y + h / 2),
		Size = UDim2.fromOffset(w, h),
	}
end

-- Rect on the root canvas, pinned to a screen edge.
-- h = "L" | "C" | "R", v = "T" | "C" | "B"
local function screenRect(h, v, x, y, w, hgt)
	local cx, cy = x + w / 2, y + hgt / 2
	local px = (h == "L" and UDim.new(0, cx)) or (h == "R" and UDim.new(1, cx - REF_W)) or UDim.new(0.5, cx - REF_W / 2)
	local py = (v == "T" and UDim.new(0, cy)) or (v == "B" and UDim.new(1, cy - REF_H)) or UDim.new(0.5, cy - REF_H / 2)
	return {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(px, py),
		Size = UDim2.fromOffset(w, hgt),
	}
end

-- Outlined bubbly text
local function text(str, props, strokeThickness, strokeColor)
	local l = create("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = FONT,
		Text = str,
		TextColor3 = WHITE,
		TextScaled = true,
		RichText = true,
	})
	create("UIStroke", {
		Thickness = strokeThickness or 3,
		Color = strokeColor or BLACK,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = l,
	})
	return apply(l, props)
end

-- Image if an asset id is set in Config.Icons, emoji otherwise
local function icon(key, props, emojiOverride, imageOverride)
	local id = imageOverride
	if id == nil or id == "" then
		id = Config.Icons[key]
	end
	local inst
	if id and id ~= "" then
		inst = create("ImageLabel", {
			BackgroundTransparency = 1,
			Image = id,
			ScaleType = Enum.ScaleType.Fit,
		})
	else
		inst = create("TextLabel", {
			BackgroundTransparency = 1,
			Text = emojiOverride or Config.Emoji[key] or "?",
			TextScaled = true,
			FontFace = FONT,
			TextColor3 = WHITE,
		})
	end
	return apply(inst, props)
end

-- The glossy, outlined, diagonal-striped box every button/panel uses.
-- top may be a Color3 (with bottom) or a full ColorSequence.
local function fancy(className, props, top, bottom, opts)
	opts = opts or {}
	local f = create(className, {
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	})
	if f:IsA("GuiButton") then
		f.AutoButtonColor = false
	end
	if f:IsA("TextButton") then
		f.Text = ""
	end

	create("UIGradient", {
		Color = typeof(top) == "ColorSequence" and top or ColorSequence.new(top, bottom),
		Rotation = opts.Rotation or 90,
		Parent = f,
	})
	create("UICorner", { CornerRadius = UDim.new(0, opts.Corner or 5), Parent = f })
	create("UIStroke", {
		Thickness = opts.Stroke or 4,
		Color = opts.StrokeColor or BLACK,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = f,
	})

	if not opts.NoShine then
		-- top gloss
		local gloss = create("Frame", {
			Name = "Gloss",
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 0.5),
			Parent = f,
		})
		create("UICorner", { CornerRadius = UDim.new(0, opts.Corner or 5), Parent = gloss })
		create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new(0.72, 0.95),
			Parent = gloss,
		})
		-- diagonal shine stripes
		local stripes = create("Frame", {
			Name = "Stripes",
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Parent = f,
		})
		create("UICorner", { CornerRadius = UDim.new(0, opts.Corner or 5), Parent = stripes })
		create("UIGradient", { Rotation = -60, Transparency = STRIPES, Parent = stripes })
	end

	-- inner light rim
	local rim = create("Frame", {
		Name = "Rim",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
		Parent = f,
	})
	create("UICorner", { CornerRadius = UDim.new(0, math.max((opts.Corner or 5) - 2, 0)), Parent = rim })
	create("UIStroke", {
		Thickness = 2,
		Color = WHITE,
		Transparency = opts.RimTransparency or 0.45,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = rim,
	})

	return apply(f, props)
end

local function setGradient(box, top, bottom)
	local g = box:FindFirstChildOfClass("UIGradient")
	if g then
		g.Color = typeof(top) == "ColorSequence" and top or ColorSequence.new(top, bottom)
	end
end

-- Hover / press bounce + click callback
local function bind(btn, callback)
	local scale = create("UIScale", { Parent = btn })
	btn.MouseEnter:Connect(function()
		tween(scale, { Scale = 1.06 }, 0.12)
	end)
	btn.MouseLeave:Connect(function()
		tween(scale, { Scale = 1 }, 0.12)
	end)
	btn.MouseButton1Down:Connect(function()
		tween(scale, { Scale = 0.93 }, 0.07)
	end)
	btn.MouseButton1Up:Connect(function()
		tween(scale, { Scale = 1.06 }, 0.1)
	end)
	btn.Activated:Connect(callback)
	return btn
end

local function robuxPrice(parent, amount, props, color)
	local holder = create("Frame", merge({ BackgroundTransparency = 1 }, props))
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 4),
		Parent = holder,
	})
	local h = holder.Size.Y.Offset
	local ic = icon("Robux", {
		Size = UDim2.fromOffset(h * 0.85, h * 0.85),
		LayoutOrder = 1,
		Parent = holder,
	})
	if ic:IsA("ImageLabel") then
		ic.ImageColor3 = color or WHITE
	end
	text(tostring(amount), {
		Name = "Amount",
		Size = UDim2.fromOffset(h * 1.6, h),
		AutomaticSize = Enum.AutomaticSize.X,
		TextScaled = false,
		TextSize = h * 0.95,
		TextColor3 = color or WHITE,
		LayoutOrder = 2,
		Parent = holder,
	}, 3)
	holder.Parent = parent
	return holder
end

local function formatNumber(n)
	n = math.floor(tonumber(n) or 0)
	local s = tostring(math.abs(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (n < 0 and "-" or "") .. out
end

local function getStat(name)
	if not name then
		return nil
	end
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(name)
	if v and v:IsA("ValueBase") then
		return v.Value
	end
	return player:GetAttribute(name)
end

local function promptProduct(id)
	if not id or id == 0 then
		warn("[SimUI] This button has no Developer Product ID yet - set it in SimUIConfig")
		return
	end
	MarketplaceService:PromptProductPurchase(player, id)
end

local function promptPass(id)
	if not id or id == 0 then
		warn("[SimUI] This button has no Game Pass ID yet - set it in SimUIConfig")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, id)
end

---------------------------------------------------------------------
-- Root canvas
---------------------------------------------------------------------
local playerGui = player:WaitForChild("PlayerGui")
local old = playerGui:FindFirstChild("SimulatorUI")
if old then
	old:Destroy()
end

local gui = create("ScreenGui", {
	Name = "SimulatorUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	ScreenInsets = Enum.ScreenInsets.None,
	Parent = playerGui,
})
local buttonClicked = create("BindableEvent", { Name = "ButtonClicked", Parent = gui })

-- Hide the game's old HUD so the two UIs don't overlap
if Config.HideOldGuis then
	local StarterGui = game:GetService("StarterGui")
	local keep, extra = {}, {}
	for _, n in ipairs(Config.KeepGuis or {}) do
		keep[n] = true
	end
	for _, n in ipairs(Config.ExtraGuisToHide or {}) do
		extra[n] = true
	end
	local function isOld(g)
		if not g:IsA("ScreenGui") or g == gui or keep[g.Name] then
			return false
		end
		return extra[g.Name] or StarterGui:FindFirstChild(g.Name) ~= nil
	end
	local function hide(g)
		if isOld(g) then
			g.Enabled = false
			g:GetPropertyChangedSignal("Enabled"):Connect(function()
				if g.Enabled then
					g.Enabled = false
				end
			end)
			print("[SimUI] Hid old UI:", g.Name, "- add it to Config.KeepGuis to keep it")
		end
	end
	for _, g in ipairs(playerGui:GetChildren()) do
		hide(g)
	end
	playerGui.ChildAdded:Connect(hide)
end

local root = create("Frame", {
	Name = "Root",
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Parent = gui,
})
local rootScale = create("UIScale", { Parent = root })

local function rescale()
	local vp = gui.AbsoluteSize
	if vp.X <= 0 or vp.Y <= 0 then
		return
	end
	local s = math.min(vp.X / REF_W, vp.Y / REF_H)
	rootScale.Scale = s
	root.Size = UDim2.fromOffset(vp.X / s, vp.Y / s)
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
rescale()

---------------------------------------------------------------------
-- Window manager
---------------------------------------------------------------------
local windows = {}
local openName = nil

local function closeWindow()
	if openName and windows[openName] then
		windows[openName].Visible = false
	end
	openName = nil
end

local function openWindow(name)
	if openName == name then
		closeWindow()
		return
	end
	closeWindow()
	local w = windows[name]
	if not w then
		return
	end
	local scale = w:FindFirstChild("PopScale")
	scale.Scale = 0.7
	w.Visible = true
	tween(scale, { Scale = 1 }, 0.28, Enum.EasingStyle.Back)
	openName = name
end

local function clicked(name)
	return function()
		if name == "MyBase" then
			closeWindow()
			Remotes:WaitForChild("GoToBase"):FireServer()
		elseif windows[name] then
			openWindow(name)
		end
		buttonClicked:Fire(name)
	end
end

local applyData -- assigned near the bottom

-- Window shell: header bar with icon, title, close X, and a dark body
local function makeWindow(name, h, v, x, y, w, hgt, headTop, headBottom, iconKey, title)
	local win = create("Frame", merge(screenRect(h, v, x, y, w, hgt), {
		Name = name,
		BackgroundColor3 = rgb(40, 44, 40),
		BackgroundTransparency = 0.15,
		Visible = false,
		ZIndex = 5,
		Parent = root,
	}))
	create("UIScale", { Name = "PopScale", Parent = win })
	create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = win })
	create("UIStroke", { Thickness = 5, Color = BLACK, Parent = win })

	local header = fancy("Frame", merge(rect(0, 0, w, 112), { Name = "Header", Parent = win }), headTop, headBottom, {
		Corner = 4,
	})
	-- darker line under header
	create("Frame", {
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 5),
		Parent = header,
	})

	icon(iconKey, merge(rect(-22, -22, 130, 130), { Rotation = -12, Parent = win }))
	text(title, merge(rect(120, 14, 600, 86), {
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = win,
	}), 5)

	local close = fancy("TextButton", merge(rect(w - 93, 14, 78, 78), { Name = "Close", Parent = win }),
		rgb(255, 80, 85), rgb(200, 15, 30), { Corner = 6 })
	text("X", merge(rect(8, 4, 62, 66), { Parent = close }), 4)
	bind(close, closeWindow)

	windows[name] = win
	return win, close
end

