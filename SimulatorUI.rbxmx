TreadmillSkins.Themes = Themes

---------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------
function TreadmillSkins.Build(skinName, cframe)
	local t = Themes[skinName]
	assert(t, "Unknown treadmill skin: " .. tostring(skinName))
	local m = Instance.new("Model")
	m.Name = skinName .. "Treadmill"
	m:SetAttribute("Skin", skinName)
	local console = buildBase(m, t)
	if t.Deco then
		t.Deco(m, console)
	end
	if cframe then
		m:PivotTo(cframe)
	end
	return m
end

-- Replace an existing treadmill model with a skinned one, keeping its
-- position, name, attributes and non-visual children (scripts, values,
-- configurations, prompts, sounds, etc.).
function TreadmillSkins.Swap(old, skinName, tier)
	local new = TreadmillSkins.Build(skinName, old:GetPivot())
	if tier then
		new:SetAttribute("Tier", tier)
		CollectionService:AddTag(new, "Treadmill")
	end
	new.Name = old.Name
	for k, v in pairs(old:GetAttributes()) do
		new:SetAttribute(k, v)
	end
	new:SetAttribute("Skin", skinName)
	for _, child in ipairs(old:GetChildren()) do
		if not child:IsA("BasePart") and not child:IsA("Model") and not child:IsA("Folder") then
			child.Parent = new
		end
	end
	-- move prompts / clickdetectors / touch scripts that lived inside parts
	for _, d in ipairs(old:GetDescendants()) do
		if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") or d:IsA("BaseScript") then
			if d.Parent and d.Parent:IsA("BasePart") then
				local target = new:FindFirstChild(d.Parent.Name) or new:FindFirstChild("Hitbox")
				d.Parent = target
			end
		end
	end
	new.Parent = old.Parent
	old:Destroy()
	return new
end

function TreadmillSkins.SwapAll(folder, skinName)
	local out = {}
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("Model") then
			table.insert(out, TreadmillSkins.Swap(child, skinName))
		end
	end
	return out
end

-- Builds templates in ServerStorage and a two-row showcase in Workspace.
function TreadmillSkins.Install(origin)
	origin = origin or CF(0, 0, 0)

	local templates = game:GetService("ServerStorage"):FindFirstChild("TreadmillSkins")
	if templates then
		templates:Destroy()
	end
	templates = Instance.new("Folder")
	templates.Name = "TreadmillSkins"
	templates.Parent = game:GetService("ServerStorage")

	local showcase = workspace:FindFirstChild("TreadmillShowcase")
	if showcase then
		showcase:Destroy()
	end
	showcase = Instance.new("Folder")
	showcase.Name = "TreadmillShowcase"
	showcase.Parent = workspace

	-- two-tier display like a shop shelf: front row low, back row raised
	local spacing = 14
	local platformColor = rgb(40, 50, 95)
	local frontLen = spacing * 6
	P(showcase, "FrontStage", V(frontLen + 6, 1, 18), origin * CF(0, -0.5, 0), platformColor, M.SmoothPlastic,
		{ CanCollide = true })
	P(showcase, "BackStage", V(frontLen + 6, 6, 16), origin * CF(0, 2.5, -17), platformColor, M.SmoothPlastic,
		{ CanCollide = true })
	P(showcase, "FrontEdge", V(frontLen + 6, 0.25, 0.25), origin * CF(0, 0.05, 9), rgb(60, 220, 255), M.Neon)
	P(showcase, "BackEdge", V(frontLen + 6, 0.25, 0.25), origin * CF(0, 5.55, -9), rgb(255, 80, 230), M.Neon)

	for i, name in ipairs(TreadmillSkins.Skins) do
		local template = TreadmillSkins.Build(name)
		template.Parent = templates

		local row = i <= 6 and 0 or 1
		local col = (i - 1) % 6
		local x = -frontLen / 2 + spacing / 2 + col * spacing
		local pos = row == 0 and CF(x, 0, 0) or CF(x, 5.5, -17)
		local display = template:Clone()
		display:PivotTo(origin * pos)
		display.Parent = showcase
	end

	print("[TreadmillSkins] Installed 12 skins: ServerStorage.TreadmillSkins + Workspace.TreadmillShowcase")
	return templates, showcase
end

return TreadmillSkins
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">TreadmillConfig</string><ProtectedString name="Source"><![CDATA[--[[
	TreadmillConfig  (ModuleScript -> ReplicatedStorage)

	12 treadmill tiers. Tier 1 is free; each next tier must be bought
	with Cash (in order) and gives more Speed per second while running.
]]

local T = {}

T.Stat = "Speed" -- the stat treadmills train (leaderstats value or Player attribute)
T.CashStat = "Cash" -- what unlocking costs
T.TickSeconds = 1 -- how often Speed is given while running

-- Speed also makes you walk faster: +1 WalkSpeed per 1,000 Speed, max +60
T.BaseWalkSpeed = 16
T.WalkSpeedPerSpeed = 1 / 1000
T.MaxWalkSpeedBonus = 60

T.Tiers = {
	{ Name = "Basic", Skin = "Basic", Price = 0, Gain = 1 },
	{ Name = "Jungle", Skin = "Jungle", Price = 5e3, Gain = 3 },
	{ Name = "Tech", Skin = "Tech", Price = 50e3, Gain = 8 },
	{ Name = "Hacker", Skin = "Hacker", Price = 500e3, Gain = 20 },
	{ Name = "Frost", Skin = "Frost", Price = 5e6, Gain = 50 },
	{ Name = "Toxic", Skin = "Toxic", Price = 50e6, Gain = 120 },
	{ Name = "Candy", Skin = "Candy", Price = 500e6, Gain = 300 },
	{ Name = "Ocean", Skin = "Ocean", Price = 5e9, Gain = 750 },
	{ Name = "Lucky", Skin = "Lucky", Price = 50e9, Gain = 2000 },
	{ Name = "Alien", Skin = "Alien", Price = 500e9, Gain = 5000 },
	{ Name = "Inferno", Skin = "Inferno", Price = 5e12, Gain = 12500 },
	{ Name = "Golden", Skin = "Golden", Price = 50e12, Gain = 30000 },
}

-- Player attributes (set by game passes) that multiply Speed gain
T.Multipliers = {
	{ Attribute = "X2Speed", Mult = 2 },
	{ Attribute = "VIP", Mult = 1.5 },
}
T.AllTreadmillsAttribute = "AllTreadmills" -- game pass: every tier unlocked

local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
function T.Format(n)
	n = tonumber(n) or 0
	local neg = n < 0
	n = math.abs(n)
	if n < 1000 then
		return (neg and "-" or "") .. tostring(math.floor(n))
	end
	local i = 1
	while n >= 1000 and i < #SUFFIX do
		n /= 1000
		i += 1
	end
	local s
	if n >= 100 then
		s = tostring(math.floor(n))
	else
		s = string.format("%.1f", math.floor(n * 10) / 10)
		s = (s:gsub("%.0$", ""))
	end
	return (neg and "-" or "") .. s .. SUFFIX[i]
end

return T
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	WorldBuilder  (ModuleScript -> ReplicatedStorage)

	Run ONCE in Studio's Command Bar (edit mode, not while playing):

		require(game.ReplicatedStorage.WorldBuilder).Install()

	It builds / changes:
	  1. Workspace.TreadmillGym  - a neon two-tier gym with all 12 tier
	     treadmills, stairs, an arch sign and a glowing back wall.
	     It's one Model: drag it anywhere you like afterwards.
	  2. Sell booth glow-up     - every Model/Part with "sell" in its name
	     gets a pulsing neon ring, orbiting lights, a floating spinning
	     cash stack, money sparkles and a bouncing "SELL" sign
	     (added next to it in Workspace.SellBoothFx, your booth isn't touched).
	  3. Lighting               - bloom, atmosphere, colour boost, sun rays.

	Each part can be re-run on its own:
	  .BuildGym(cframe?)  .DecorateSellBooths()  .Lighting()
	Run .Install() again any time; it replaces what it made before.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Skins = require(ReplicatedStorage:WaitForChild("TreadmillSkins"))
local TC = require(ReplicatedStorage:WaitForChild("TreadmillConfig"))
local fx = Skins.fx

local WB = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local rgb = Color3.fromRGB
local M = Enum.Material

local NAVY = rgb(38, 42, 98)
local NAVY_DARK = rgb(26, 28, 70)
local PINK = rgb(255, 70, 220)
local CYAN = rgb(60, 230, 255)
local YELLOW = rgb(255, 215, 50)

local function P(parent, name, size, cframe, color, material, props)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function sign(part, face, text, gradient, ppm)
	local g = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = ppm or 40
	g.LightInfluence = 0
	g.Brightness = 2
	g.Parent = part
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Parent = g
	local st = Instance.new("UIStroke")
	st.Thickness = 6
	st.Color = rgb(20, 10, 40)
	st.Parent = t
	if gradient then
		local gr = Instance.new("UIGradient")
		gr.Color = gradient
		gr.Parent = t
	end
	return g
end

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, rgb(255, 230, 60)),
	ColorSequenceKeypoint.new(0.35, rgb(255, 90, 200)),
	ColorSequenceKeypoint.new(0.7, rgb(120, 110, 255)),
	ColorSequenceKeypoint.new(1, rgb(60, 230, 255)),
})

local function light(part, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Parent = part
end

local function defaultOrigin()
	local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawn then
		local ground = spawn.Position.Y - spawn.Size.Y / 2
		return CF(spawn.Position.X, ground, spawn.Position.Z - 80)
	end
	return CF(0, 0, -80)
end

---------------------------------------------------------------------
-- 1. Treadmill gym
---------------------------------------------------------------------
function WB.BuildGym(origin)
	origin = origin or defaultOrigin()
	local old = workspace:FindFirstChild("TreadmillGym")
	if old then
		origin = old:GetPivot() -- keep it where you moved it
		old:Destroy()
	end

	local gym = Instance.new("Model")
	gym.Name = "TreadmillGym"

	local spacing = 14
	local width = spacing * 6 + 26
	local backTop = 6.4

	-- floors
	P(gym, "Floor", V(width, 0.8, 18), CF(0, 0, 0), NAVY, M.SmoothPlastic)
	P(gym, "BackStage", V(width, backTop, 16), CF(0, backTop / 2, -17), NAVY_DARK, M.SmoothPlastic)
	-- checker glow tiles on the floor
	for i = 0, 5 do
		local x = -spacing * 2.5 + i * spacing
		fx(P(gym, "Pad", V(8, 0.1, 13), CF(x, 0.45, 0.3), i % 2 == 0 and PINK or CYAN, M.Neon, { CanCollide = false,
			Transparency = 0.55 }), "Pulse", 2, 0.35, i)
		fx(P(gym, "Pad", V(8, 0.1, 13), CF(x, backTop + 0.05, -16.7), i % 2 == 0 and CYAN or PINK, M.Neon, {
			CanCollide = false, Transparency = 0.55 }), "Pulse", 2, 0.35, i + 3)
	end
	-- neon edges
	fx(P(gym, "EdgeFront", V(width, 0.3, 0.3), CF(0, 0.45, 9), CYAN, M.Neon, { CanCollide = false }), "Pulse", 3, 0.5)
	fx(P(gym, "EdgeBack", V(width, 0.3, 0.3), CF(0, backTop + 0.1, -9), PINK, M.Neon, { CanCollide = false }), "Pulse",
		3, 0.5, 1.5)
	for i = 0, 3 do
		fx(P(gym, "StageStripe", V(width, 0.2, 0.2), CF(0, 1.2 + i * 1.4, -8.95), i % 2 == 0 and PINK or CYAN, M.Neon,
			{ CanCollide = false }), "Pulse", 2, 0.6, i)
	end

	-- stairs to the back row on both ends
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * (width / 2 - 5)
		for k = 1, 6 do
			local h = k * (backTop - 0.4) / 6
			P(gym, "Step", V(8, h, 1.4), CF(x, 0.4 + h / 2, -9 + (6.5 - k) * 1.4), NAVY)
			fx(P(gym, "StepGlow", V(8, 0.12, 0.15), CF(x, 0.4 + h + 0.06, -9 + (6.5 - k) * 1.4 + 0.7), CYAN, M.Neon,
				{ CanCollide = false }), "Pulse", 4, 0.6, k * 0.5)
		end
	end

	-- back wall with title
	local wall = P(gym, "BackWall", V(width, 18, 1), CF(0, backTop + 9, -25.5), NAVY_DARK)
	sign(P(gym, "TitlePanel", V(60, 9, 0.2), CF(0, backTop + 11, -24.9), NAVY_DARK, M.SmoothPlastic,
		{ CanCollide = false }), Enum.NormalId.Front, "⚡ TREADMILLS ⚡", RAINBOW, 20)
	for i = 0, 2 do
		fx(P(gym, "WallStripe", V(width, 0.3, 0.3), CF(0, backTop + 2 + i * 6, -24.95), ({ PINK, CYAN, YELLOW })[i + 1],
			M.Neon, { CanCollide = false }), "Pulse", 2.5, 0.5, i)
	end
	light(wall, PINK, 40, 1.5)

	-- entrance arch
	local archZ = 13
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * 22
		P(gym, "Pillar", V(3, 20, 3), CF(x, 10, archZ), NAVY)
		for k = 0, 3 do
			fx(P(gym, "PillarRing", V(3.6, 0.5, 3.6), CF(x, 3 + k * 4.5, archZ), k % 2 == 0 and PINK or CYAN, M.Neon,
				{ CanCollide = false }), "Bob", 2, 0.6, k + sx)
		end
		local orb = P(gym, "Orb", V(3.4, 3.4, 3.4), CF(x, 22, archZ), YELLOW, M.Neon,
			{ Shape = Enum.PartType.Ball, CanCollide = false })
		fx(orb, "Bob", 2, 0.8, sx)
		light(orb, YELLOW, 30, 2)
	end
	local beam = P(gym, "ArchSign", V(47, 6, 1.5), CF(0, 21, archZ), NAVY_DARK)
	sign(beam, Enum.NormalId.Back, "TREADMILL GYM", RAINBOW, 30)
	sign(beam, Enum.NormalId.Front, "TREADMILL GYM", RAINBOW, 30)
	fx(P(gym, "ArchTrim", V(47.4, 0.4, 1.9), CF(0, 18, archZ), PINK, M.Neon, { CanCollide = false }), "Pulse", 3, 0.5)
	fx(P(gym, "ArchTrim", V(47.4, 0.4, 1.9), CF(0, 24, archZ), CYAN, M.Neon, { CanCollide = false }), "Pulse", 3, 0.5,
		1.5)

	-- treadmills: tiers 1-6 front row, 7-12 raised back row
	for i, tier in ipairs(TC.Tiers) do
		local row = i <= 6 and 0 or 1
		local col = (i - 1) % 6
		local x = -spacing * 2.5 + col * spacing
		local pos = row == 0 and CF(x, 0.4, 0) or CF(x, backTop, -17)
		local m = Skins.Build(tier.Skin, pos)
		m.Name = string.format("Treadmill%02d_%s", i, tier.Name)
		m:SetAttribute("Tier", i)
		CollectionService:AddTag(m, "Treadmill")
		m.Parent = gym
	end

	gym.PrimaryPart = gym:FindFirstChild("Floor")
	gym:PivotTo(origin)
	gym.Parent = workspace
	return gym
end

---------------------------------------------------------------------
-- 2. Sell booth glow-up
---------------------------------------------------------------------
local function isSell(inst)
	return inst.Name:lower():find("sell") ~= nil
end

function WB.DecorateSellBooths()
	local old = workspace:FindFirstChild("SellBoothFx")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "SellBoothFx"
	folder.Parent = workspace

	local count = 0
	for _, inst in ipairs(workspace:GetDescendants()) do
		if (inst:IsA("Model") or inst:IsA("BasePart")) and isSell(inst) then
			-- only the outermost "sell" object, and never players / our own fx
			local parent = inst.Parent
			local nested = false
			while parent and parent ~= workspace do
				if isSell(parent) or parent:FindFirstChildOfClass("Humanoid") then
					nested = true
					break
				end
				parent = parent.Parent
			end
			if not nested and not inst:FindFirstChildOfClass("Humanoid") then
				count += 1
				local cf, size
				if inst:IsA("Model") then
					cf, size = inst:GetBoundingBox()
				else
					cf, size = inst.CFrame, inst.Size
				end
				local ground = cf.Position.Y - size.Y / 2
				local center = V(cf.Position.X, ground, cf.Position.Z)
				local radius = math.max(size.X, size.Z) / 2 + 4

				local fxModel = Instance.new("Model")
				fxModel.Name = "SellFx_" .. inst.Name
				fxModel.Parent = folder

				-- pulsing neon ring
				local ring = P(fxModel, "Ring", V(0.15, radius * 2, radius * 2), CF(center + V(0, 0.1, 0))
					* ANG(0, 0, rad(90)), rgb(90, 255, 90), M.Neon, { Shape = Enum.PartType.Cylinder, CanCollide = false,
					Transparency = 0.4 })
				fx(ring, "Pulse", 2.5, 0.45)
				local inner = P(fxModel, "RingInner", V(0.16, radius * 2 - 1.2, radius * 2 - 1.2), CF(center + V(0, 0.1, 0))
					* ANG(0, 0, rad(90)), rgb(30, 120, 40), M.SmoothPlastic, { Shape = Enum.PartType.Cylinder,
					CanCollide = false, Transparency = 0.2 })
				inner.Name = "RingInner"

				-- orbiting lights
				for k = 0, 11 do
					local a = k / 12 * math.pi * 2
					local dot = P(fxModel, "OrbitDot", V(1.2, 0.4, 1.2), CF(center + V(math.cos(a) * (radius + 1), 0.4,
						math.sin(a) * (radius + 1))), k % 2 == 0 and YELLOW or rgb(90, 255, 90), M.Neon,
						{ CanCollide = false })
					dot:SetAttribute("FxCenter", center)
					fx(dot, "Orbit", 0.6)
				end

				-- floating spinning cash stack
				local top = ground + size.Y + 3
				for k = 0, 3 do
					fx(P(fxModel, "Cash", V(3, 0.7, 1.6), CF(center + V(0, top - ground + k * 0.75, 0)) * ANG(0, rad(k * 12), 0),
						k % 2 == 0 and rgb(70, 200, 70) or rgb(255, 210, 60), M.SmoothPlastic, { CanCollide = false }),
						"Float", 1.5, 0.8)
				end

				-- bouncing sign
				local signPart = P(fxModel, "SignAnchor", V(1, 1, 1), CF(center + V(0, top - ground + 6, 0)), YELLOW,
					M.SmoothPlastic, { Transparency = 1, CanCollide = false })
				fx(signPart, "Bob", 2.5, 0.8)
				local bb = Instance.new("BillboardGui")
				bb.Size = UDim2.fromScale(14, 4)
				bb.LightInfluence = 0
				bb.MaxDistance = 250
				bb.Parent = signPart
				local t = Instance.new("TextLabel")
				t.Size = UDim2.fromScale(1, 1)
				t.BackgroundTransparency = 1
				t.Font = Enum.Font.FredokaOne
				t.TextScaled = true
				t.Text = "💰 SELL HERE 💰"
				t.TextColor3 = Color3.new(1, 1, 1)
				t.Parent = bb
				local st = Instance.new("UIStroke")
				st.Thickness = 4
				st.Parent = t
				local g = Instance.new("UIGradient")
				g.Color = ColorSequence.new(rgb(255, 240, 90), rgb(80, 255, 90))
				g.Rotation = 90
				g.Parent = t

				-- money sparkles + glow
				local emitter = P(fxModel, "MoneyFx", V(radius * 1.6, 0.2, radius * 1.6), CF(center + V(0, 0.5, 0)),
					YELLOW, M.SmoothPlastic, { Transparency = 1, CanCollide = false })
				local pe = Instance.new("ParticleEmitter")
				pe.Color = ColorSequence.new(rgb(120, 255, 90), rgb(255, 230, 80))
				pe.LightEmission = 0.8
				pe.Rate = 12
				pe.Lifetime = NumberRange.new(1.2, 2)
				pe.Speed = NumberRange.new(3, 6)
				pe.SpreadAngle = Vector2.new(20, 20)
				pe.EmissionDirection = Enum.NormalId.Top
				pe.Size = NumberSequence.new(0.5, 0)
				pe.Parent = emitter
				light(emitter, rgb(110, 255, 110), radius * 2.5, 2)
			end
		end
	end
	print("[WorldBuilder] Decorated " .. count .. " sell booth(s)")
	return count
end

---------------------------------------------------------------------
-- 3. Lighting
---------------------------------------------------------------------
local function getOrMake(className, name)
	local inst = Lighting:FindFirstChildOfClass(className)
	if not inst then
		inst = Instance.new(className)
		inst.Name = name
		inst.Parent = Lighting
	end
	return inst
end

function WB.Lighting()
	Lighting.Brightness = 2.6
	Lighting.ClockTime = 14.5
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.OutdoorAmbient = rgb(150, 150, 175)
	Lighting.Ambient = rgb(90, 90, 110)

	local atmo = getOrMake("Atmosphere", "Atmosphere")
	atmo.Density = 0.27
	atmo.Offset = 0.15
	atmo.Color = rgb(200, 225, 255)
	atmo.Decay = rgb(120, 160, 255)
	atmo.Glare = 0.4
	atmo.Haze = 1.2

	local bloom = getOrMake("BloomEffect", "Bloom")
	bloom.Intensity = 0.7
	bloom.Size = 28
	bloom.Threshold = 1.6

	local cc = getOrMake("ColorCorrectionEffect", "ColorCorrection")
	cc.Saturation = 0.28
	cc.Contrast = 0.12
	cc.Brightness = 0.02
	cc.TintColor = rgb(255, 250, 245)

	local rays = getOrMake("SunRaysEffect", "SunRays")
	rays.Intensity = 0.06
	rays.Spread = 0.6
end

function WB.Install(origin)
	WB.Lighting()
	local gym = WB.BuildGym(origin)
	WB.DecorateSellBooths()
	print("[WorldBuilder] Done! Workspace.TreadmillGym is at " .. tostring(gym:GetPivot().Position)
		.. " - drag it wherever you want it.")
	return gym
end

return WB
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX7"><Properties><string name="Name">TreadmillServer</string><ProtectedString name="Source"><![CDATA[--[[
	TreadmillServer  (Script -> ServerScriptService)

	- Saves each player's unlocked treadmill tier + Speed
	- Gives Speed every second while the player is running on a treadmill
	  they've unlocked (checked server-side, so it can't be faked)
	- Unlocks the next tier for Cash
	- Speed makes the player walk faster (see TreadmillConfig)

	Treadmills are Models tagged "Treadmill" with a "Tier" attribute and a
	"Hitbox" part (WorldBuilder.Install() sets these up).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")
local CollectionService = game:GetService("CollectionService")
local StarterPlayer = game:GetService("StarterPlayer")

local TC = require(ReplicatedStorage:WaitForChild("TreadmillConfig"))
local MAX_TIER = #TC.Tiers

local remotes = ReplicatedStorage:FindFirstChild("TreadmillRemotes") or Instance.new("Folder")
remotes.Name = "TreadmillRemotes"
remotes.Parent = ReplicatedStorage
local function remote(className, name)
	local r = remotes:FindFirstChild(name) or Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local SetRunning = remote("RemoteEvent", "SetRunning")
local Trained = remote("RemoteEvent", "Trained")
local Unlock = remote("RemoteFunction", "Unlock")

local store
pcall(function()
	store = DataStoreService:GetDataStore("Treadmill_v1")
end)

local sessions = {} -- [player] = { Tier = n, Running = model? }

---------------------------------------------------------------------
-- Stats (leaderstats value if present, Player attribute otherwise)
---------------------------------------------------------------------
local function valueObj(player, name)
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(name)
	if v and (v:IsA("IntValue") or v:IsA("NumberValue")) then
		return v
	end
	return nil
end

local function getStat(player, name)
	local v = valueObj(player, name)
	if v then
		return v.Value
	end
	return player:GetAttribute(name) or 0
end

local function setStat(player, name, value)
	local v = valueObj(player, name)
	if v then
		v.Value = value
	else
		player:SetAttribute(name, value)
	end
end

local function effectiveTier(player)
	local s = sessions[player]
	if player:GetAttribute(TC.AllTreadmillsAttribute) then
		return MAX_TIER
	end
	return s and s.Tier or 1
end

local function publishTier(player)
	player:SetAttribute("TreadmillTier", effectiveTier(player))
end

local function applyWalkSpeed(player)
	local speed = getStat(player, TC.Stat)
	local bonus = math.min(speed * TC.WalkSpeedPerSpeed, TC.MaxWalkSpeedBonus)
	player:SetAttribute("TreadmillSpeedBonus", bonus)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		local base = StarterPlayer.CharacterWalkSpeed or TC.BaseWalkSpeed
		hum.WalkSpeed = base + bonus + (player:GetAttribute("WalkSpeedBonus") or 0)
	end
end

local function multiplier(player)
	local m = 1
	for _, mult in ipairs(TC.Multipliers) do
		if player:GetAttribute(mult.Attribute) then
			m *= mult.Mult
		end
	end
	return m
end

---------------------------------------------------------------------
-- Save / load
---------------------------------------------------------------------
local function save(player)
	local s = sessions[player]
	if not s or not store then
		return
	end
	local data = { Tier = s.Tier, Speed = getStat(player, TC.Stat) }
	local ok, err = pcall(function()
		store:SetAsync("u" .. player.UserId, data)
	end)
	if not ok then
		warn("[Treadmill] save failed", err)
	end
end

local function onJoin(player)
	local data
	if store then
		local ok, result = pcall(function()
			return store:GetAsync("u" .. player.UserId)
		end)
		if ok then
			data = result
		end
	end
	data = data or {}
	sessions[player] = { Tier = math.clamp(tonumber(data.Tier) or 1, 1, MAX_TIER), Running = nil }

	-- show Speed on the leaderboard if the game uses leaderstats
	local ls = player:WaitForChild("leaderstats", 5)
	if ls and not ls:FindFirstChild(TC.Stat) then
		local v = Instance.new("NumberValue")
		v.Name = TC.Stat
		v.Parent = ls
	end
	setStat(player, TC.Stat, tonumber(data.Speed) or 0)

	publishTier(player)
	player:GetAttributeChangedSignal(TC.AllTreadmillsAttribute):Connect(function()
		publishTier(player)
	end)
	player.CharacterAdded:Connect(function()
		task.wait(0.3)
		applyWalkSpeed(player)
	end)
	applyWalkSpeed(player)
end

Players.PlayerAdded:Connect(onJoin)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onJoin, p)
end

Players.PlayerRemoving:Connect(function(player)
	save(player)
	sessions[player] = nil
end)

game:BindToClose(function()
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(save, p)
	end
	task.wait(3)
end)

task.spawn(function()
	while true do
		task.wait(60)
		for _, p in ipairs(Players:GetPlayers()) do
			task.spawn(save, p)
		end
	end
end)

---------------------------------------------------------------------
-- Running
---------------------------------------------------------------------
local function nearTreadmill(player, model)
	local hit = model:FindFirstChild("Hitbox")
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	return hit and root and (root.Position - hit.Position).Magnitude < 16
end

SetRunning.OnServerEvent:Connect(function(player, model)
	local s = sessions[player]
	if not s then
		return
	end
	if model == nil then
		s.Running = nil
		return
	end
	if typeof(model) ~= "Instance" or not CollectionService:HasTag(model, "Treadmill") then
		return
	end
	local tier = model:GetAttribute("Tier") or 1
	if tier <= effectiveTier(player) and nearTreadmill(player, model) then
		s.Running = model
	end
end)

task.spawn(function()
	while true do
		task.wait(TC.TickSeconds)
		for player, s in pairs(sessions) do
			local model = s.Running
			if model then
				if model.Parent and nearTreadmill(player, model) then
					local tierInfo = TC.Tiers[model:GetAttribute("Tier") or 1] or TC.Tiers[1]
					local gain = tierInfo.Gain * multiplier(player)
					setStat(player, TC.Stat, getStat(player, TC.Stat) + gain)
					applyWalkSpeed(player)
					Trained:FireClient(player, gain)
				else
					s.Running = nil
				end
			end
		end
	end
end)

---------------------------------------------------------------------
-- Unlocking
---------------------------------------------------------------------
local busy = {}
local function unlockNext(player, free)
	local s = sessions[player]
	if not s then
		return false, "Loading..."
	end
	local nextTier = s.Tier + 1
	if nextTier > MAX_TIER then
		return false, "All unlocked!"
	end
	if not free then
		local price = TC.Tiers[nextTier].Price
		local cash = getStat(player, TC.CashStat)
		if cash < price then
			return false, "Need $" .. TC.Format(price - cash) .. " more"
		end
		setStat(player, TC.CashStat, cash - price)
	end
	s.Tier = nextTier
	publishTier(player)
	task.spawn(save, player)
	return true, TC.Tiers[nextTier].Name .. " unlocked!"
end

Unlock.OnServerInvoke = function(player, tier)
	if busy[player] then
		return false, nil
	end
	local s = sessions[player]
	if not s or tier ~= s.Tier + 1 then
		return false, "Unlock the previous treadmill first"
	end
	busy[player] = true
	local ok, msg = unlockNext(player, false)
	busy[player] = nil
	return ok, msg
end

-- "Skip to next treadmill" developer product (granted by SimUIServer)
task.spawn(function()
	local grant = ServerStorage:WaitForChild("SimUI_GrantReward", 30)
	if grant then
		grant.Event:Connect(function(player, reward)
			if type(reward) == "table" and reward.Type == "Product" and reward.Key == "TreadmillSkip" then
				unlockNext(player, true)
			end
		end)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX8"><Properties><string name="Name">TreadmillClient</string><ProtectedString name="Source"><![CDATA[--[[
	TreadmillClient  (LocalScript -> StarterPlayer > StarterPlayerScripts)

	- Step onto an unlocked treadmill: you snap onto the belt, face the
	  console and auto-run with your run animation. Press Jump to hop off.
	- Signs above every treadmill show tier, Speed/s and unlock price.
	- The next locked treadmill has an "Unlock" prompt (E / tap).
	- "+X Speed" popups while training.
	- Animates every part tagged "TreadFx" (belts, UFOs, candy wheels,
	  lucky blocks, glowing trims, sell booth effects ...).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local TC = require(ReplicatedStorage:WaitForChild("TreadmillConfig"))
local Remotes = ReplicatedStorage:WaitForChild("TreadmillRemotes")

local FONT = Enum.Font.FredokaOne
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function myTier()
	return player:GetAttribute("TreadmillTier") or 1
end

---------------------------------------------------------------------
-- Toast message
---------------------------------------------------------------------
local toastGui = Instance.new("ScreenGui")
toastGui.Name = "TreadmillToast"
toastGui.ResetOnSpawn = false
toastGui.DisplayOrder = 20
toastGui.Parent = player:WaitForChild("PlayerGui")

local toast = Instance.new("TextLabel")
toast.AnchorPoint = Vector2.new(0.5, 0)
toast.Position = UDim2.fromScale(0.5, 0.16)
toast.Size = UDim2.fromScale(0.6, 0.07)
toast.BackgroundTransparency = 1
toast.Font = FONT
toast.TextScaled = true
toast.TextColor3 = Color3.new(1, 1, 1)
toast.TextTransparency = 1
toast.Parent = toastGui
local toastStroke = Instance.new("UIStroke")
toastStroke.Thickness = 3
toastStroke.Transparency = 1
toastStroke.Parent = toast

local toastId = 0
local function showToast(msg, color)
	toastId += 1
	local id = toastId
	toast.Text = msg
	toast.TextColor3 = color or Color3.new(1, 1, 1)
	toast.TextTransparency = 0
	toastStroke.Transparency = 0
	task.delay(2, function()
		if id == toastId then
			TweenService:Create(toast, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			TweenService:Create(toastStroke, TweenInfo.new(0.4), { Transparency = 1 }):Play()
		end
	end)
end

---------------------------------------------------------------------
-- Signs + unlock prompts
---------------------------------------------------------------------
local signs = {} -- [model] = { Status, Prompt, Tier }

local function refreshSign(model)
	local info = signs[model]
	if not info then
		return
	end
	local tier = info.Tier
	local mine = myTier()
	if tier <= mine then
		info.Status.Text = "✅ UNLOCKED"
		info.Status.TextColor3 = rgb(120, 255, 90)
		info.Prompt.Enabled = false
	elseif tier == mine + 1 then
		info.Status.Text = "🔒 $" .. TC.Format(TC.Tiers[tier].Price)
		info.Status.TextColor3 = rgb(255, 220, 60)
		info.Prompt.Enabled = true
	else
		info.Status.Text = "🔒 LOCKED"
		info.Status.TextColor3 = rgb(255, 80, 90)
		info.Prompt.Enabled = false
	end
end

local function setupTreadmill(model)
	if signs[model] then
		return
	end
	local tier = model:GetAttribute("Tier") or 1
	local tierInfo = TC.Tiers[tier]
	local console = model:WaitForChild("Console", 5)
	local hitbox = model:WaitForChild("Hitbox", 5)
	if not tierInfo or not console or not hitbox then
		return
	end

	local bb = Instance.new("BillboardGui")
	bb.Name = "TierSign"
	bb.Adornee = console
	bb.Size = UDim2.fromScale(9, 3.6)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
	bb.MaxDistance = 140
	bb.LightInfluence = 0
	bb.Parent = model

	local function line(text, y, h, color)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0, y)
		l.Size = UDim2.fromScale(1, h)
		l.Font = FONT
		l.TextScaled = true
		l.Text = text
		l.TextColor3 = color
		local st = Instance.new("UIStroke")
		st.Thickness = 2.5
		st.Parent = l
		l.Parent = bb
		return l
	end
	local title = line("TIER " .. tier .. " • " .. string.upper(tierInfo.Name), 0, 0.38, Color3.new(1, 1, 1))
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, rgb(255, 230, 80)),
		ColorSequenceKeypoint.new(0.5, rgb(255, 120, 220)),
		ColorSequenceKeypoint.new(1, rgb(90, 220, 255)),
	})
	grad.Parent = title
	line("⚡ +" .. TC.Format(tierInfo.Gain) .. " Speed/s", 0.38, 0.3, rgb(110, 230, 255))
	local status = line("", 0.68, 0.32, Color3.new(1, 1, 1))

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Unlock for $" .. TC.Format(tierInfo.Price)
	prompt.ObjectText = tierInfo.Name .. " Treadmill"
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = hitbox
	prompt.Triggered:Connect(function()
		local ok, msg = Remotes.Unlock:InvokeServer(tier)
		if msg then
			showToast(msg, ok and rgb(120, 255, 90) or rgb(255, 90, 90))
		end
	end)

	signs[model] = { Status = status, Prompt = prompt, Tier = tier }
	refreshSign(model)
end

for _, m in ipairs(CollectionService:GetTagged("Treadmill")) do
	task.spawn(setupTreadmill, m)
end
CollectionService:GetInstanceAddedSignal("Treadmill"):Connect(setupTreadmill)
player:GetAttributeChangedSignal("TreadmillTier"):Connect(function()
	for m in pairs(signs) do
		refreshSign(m)
	end
end)

---------------------------------------------------------------------
-- Auto-run
---------------------------------------------------------------------
local running = nil -- { Model, Track, Conn }
local cooldownModel = nil
local lastLockedToast = 0

local function inside(hitbox, pos)
	local rel = hitbox.CFrame:PointToObjectSpace(pos)
	local half = hitbox.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Z) <= half.Z and rel.Y >= -half.Y - 2 and rel.Y <= half.Y + 2
end

local function runAnimationId(character, humanoid)
	local animate = character:FindFirstChild("Animate")
	local run = animate and animate:FindFirstChild("run")
	local anim = run and run:FindFirstChildOfClass("Animation")
	if anim and anim.AnimationId ~= "" then
		return anim.AnimationId
	end
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		return "rbxassetid://180426354"
	end
	return "rbxassetid://913376220"
end

local function stopRunning(launch)
	if not running then
		return
	end
	local r = running
	running = nil
	cooldownModel = r.Model
	r.Conn:Disconnect()
	if r.Track then
		r.Track:Stop(0.2)
	end
	Remotes.SetRunning:FireServer(nil)

	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if hum then
		hum.AutoRotate = true
	end
	if launch and root and hum and r.Belt.Parent then
		-- hop off the back of the treadmill
		local back = r.Belt.CFrame * CFrame.new(0, 0, r.Belt.Size.Z / 2 + 2.5)
		root.CFrame = CFrame.lookAt(Vector3.new(back.X, root.Position.Y + 1, back.Z),
			Vector3.new(back.X, root.Position.Y + 1, back.Z) + r.Belt.CFrame.LookVector)
		root.AssemblyLinearVelocity = -r.Belt.CFrame.LookVector * 22 + Vector3.new(0, 38, 0)
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end

local function startRunning(model)
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local belt = model:FindFirstChild("Belt")
	if not hum or not root or not belt or hum.Health <= 0 then
		return
	end

	local tier = model:GetAttribute("Tier") or 1
	if tier > myTier() then
		cooldownModel = model
		if os.clock() - lastLockedToast > 2 then
			lastLockedToast = os.clock()
			local nextTier = myTier() + 1
			if tier == nextTier then
				showToast("🔒 Unlock " .. TC.Tiers[tier].Name .. " for $" .. TC.Format(TC.Tiers[tier].Price),
					rgb(255, 220, 60))
			else
				showToast("🔒 Unlock Tier " .. nextTier .. " first!", rgb(255, 90, 90))
			end
		end
		return
	end

	local top = belt.Position.Y + belt.Size.Y / 2
	local height = hum.RigType == Enum.HumanoidRigType.R6 and 3 or (hum.HipHeight + root.Size.Y / 2)
	local spot = (belt.CFrame * CFrame.new(0, 0, 1.2)).Position
	local pos = Vector3.new(spot.X, top + height, spot.Z)
	local target = CFrame.lookAt(pos, pos + belt.CFrame.LookVector)

	hum.AutoRotate = false
	local track
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		local anim = Instance.new("Animation")
		anim.AnimationId = runAnimationId(character, hum)
		local ok, t = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if ok and t then
			track = t
			track.Priority = Enum.AnimationPriority.Action
			track.Looped = true
			track:Play(0.2)
			track:AdjustSpeed(1.1 + tier * 0.07)
		end
	end

	local conn = RunService.PreSimulation:Connect(function()
		if root.Parent then
			root.CFrame = target
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end)
	running = { Model = model, Belt = belt, Track = track, Conn = conn }
	Remotes.SetRunning:FireServer(model)
	showToast("🏃 Press JUMP to get off", rgb(110, 230, 255))
end

UserInputService.JumpRequest:Connect(function()
	if running then
		stopRunning(true)
	end
end)

player.CharacterAdded:Connect(function(character)
	if running then
		running.Conn:Disconnect()
		running = nil
	end
	cooldownModel = nil
	local hum = character:WaitForChild("Humanoid")
	hum.Died:Connect(function()
		stopRunning(false)
	end)
end)

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.1 then
		return
	end
	acc = 0
	if running then
		if not running.Model.Parent then
			stopRunning(false)
		end
		return
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	for _, model in ipairs(CollectionService:GetTagged("Treadmill")) do
		local hitbox = model:FindFirstChild("Hitbox")
		if hitbox then
			local isIn = inside(hitbox, root.Position)
			if isIn and cooldownModel ~= model then
				startRunning(model)
				break
			elseif not isIn and cooldownModel == model then
				cooldownModel = nil
			end
		end
	end
end)

---------------------------------------------------------------------
-- "+X Speed" popups
---------------------------------------------------------------------
Remotes.Trained.OnClientEvent:Connect(function(gain)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Adornee = head
	bb.Size = UDim2.fromScale(5, 1.4)
	bb.StudsOffset = Vector3.new(math.random(-15, 15) / 10, 2.5, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Font = FONT
	l.TextScaled = true
	l.Text = "+" .. TC.Format(gain) .. " ⚡"
	l.TextColor3 = rgb(110, 230, 255)
	local st = Instance.new("UIStroke")
	st.Thickness = 2.5
	st.Parent = l
	l.Parent = bb
	bb.Parent = head
	local info = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(bb, info, { StudsOffset = bb.StudsOffset + Vector3.new(0, 2.5, 0) }):Play()
	TweenService:Create(l, info, { TextTransparency = 1 }):Play()
	TweenService:Create(st, info, { Transparency = 1 }):Play()
	task.delay(1, function()
		bb:Destroy()
	end)
end)

---------------------------------------------------------------------
-- Effect animator (client-side only, so it's smooth and costs no network)
---------------------------------------------------------------------
local fxParts = {} -- [part] = { Base = CFrame, Transparency = n }

local function addFx(part)
	if part:IsA("BasePart") and not fxParts[part] then
		fxParts[part] = { Base = part.CFrame, Transparency = part.Transparency }
	end
end
for _, p in ipairs(CollectionService:GetTagged("TreadFx")) do
	addFx(p)
end
CollectionService:GetInstanceAddedSignal("TreadFx"):Connect(addFx)
CollectionService:GetInstanceRemovedSignal("TreadFx"):Connect(function(p)
	fxParts[p] = nil
end)

local MAX_DIST = 220
RunService.RenderStepped:Connect(function()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local t = os.clock()
	for part, data in pairs(fxParts) do
		if not part.Parent then
			fxParts[part] = nil
			continue
		end
		local base = data.Base
		if (base.Position - camPos).Magnitude > MAX_DIST then
			continue
		end
		local kind = part:GetAttribute("Fx")
		local speed = part:GetAttribute("FxSpeed") or 1
		local amp = part:GetAttribute("FxAmp") or 0.5
		local phase = part:GetAttribute("FxPhase") or 0
		local w = t * speed + phase
		if kind == "Spin" then
			part.CFrame = CFrame.new(base.Position) * CFrame.Angles(0, w, 0) * (base - base.Position)
		elseif kind == "Bob" then
			part.CFrame = base + Vector3.new(0, math.sin(w) * amp, 0)
		elseif kind == "Float" then
			part.CFrame = CFrame.new(base.Position + Vector3.new(0, math.sin(w) * amp, 0))
				* CFrame.Angles(0, t * speed * 0.8, 0) * (base - base.Position)
		elseif kind == "Roll" then
			part.CFrame = base * CFrame.Angles(t * speed, 0, 0)
		elseif kind == "Sway" then
			part.CFrame = base * CFrame.Angles(math.sin(w) * amp * 0.5, 0, math.cos(w * 0.8) * amp)
		elseif kind == "Pulse" then
			part.Transparency = math.clamp(data.Transparency + (0.5 - 0.5 * math.sin(w)) * amp, 0, 1)
		elseif kind == "Belt" then
			-- slats slide toward the back and wrap around (amp = spacing)
			part.CFrame = base * CFrame.new(0, 0, (t * speed) % amp)
		elseif kind == "Orbit" then
			local center = part:GetAttribute("FxCenter")
			if center then
				part.CFrame = CFrame.new(center) * CFrame.Angles(0, t * speed, 0) * (CFrame.new(-center) * base)
			end
		end
	end
end)
]]></ProtectedString></Properties></Item></Item></roblox>