		local f = fancy("Frame", merge(rect(x, y, 98, 98), { Parent = parent }), rgb(150, 110, 60), rgb(90, 60, 30), {
			Stroke = 3,
			NoShine = true,
			RimTransparency = 0.7,
		})
		icon(iconKey, merge(rect(12, 4, 74, 68), { Parent = f }), emoji)
		text(label, merge(rect(4, 68, 90, 28), { Parent = f }), 3)
		return f
	end

