		CrateLabel = "1 [NAME] Crate",
		Contents = {
			{ Icon = "Cash", Count = "x1", Label = "15 min" },
			{ Icon = "Clover", Count = "x1", Label = "15 min" },
			{ Icon = "Shovel", Count = "x1", Label = "Name" },
		},
		ProductId = 0,
		Price = 19,
		OldPrice = 69,
		Key = "StarterPack",
	},
	TreadmillSkip = {
