	text("+", merge(rect(240, 80, 50, 60), { Parent = b2 }), 4)
	text(sp.Title, merge(rect(310, 6, 430, 54), { Parent = b2 }), 4)
	for i, c in ipairs(sp.Contents) do
		local x = 318 + (i - 1) * 110
		text(c.Count, merge(rect(x, 56, 98, 30), { Parent = b2 }), 3)
		slot(b2, x, 86, c.Icon, c.Label)
